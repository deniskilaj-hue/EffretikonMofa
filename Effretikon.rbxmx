	local spit = mk(folder, Vector3.new(0.4, 7, 0.4), CFrame.new(x + 8, y0 + 3.7, z), Color3.fromRGB(120, 120, 125), Enum.Material.Metal, "Spiess-Stange")
	local fleisch = mk(folder, Vector3.new(3, 5, 3), CFrame.new(x + 8, y0 + 4, z), Color3.fromRGB(170, 100, 60), Enum.Material.SmoothPlastic, "Fleisch")
	fleisch.Shape = Enum.PartType.Cylinder
	fleisch.CFrame = CFrame.new(x + 8, y0 + 4, z) * CFrame.Angles(0, 0, math.rad(90))
