---------------------------------------------------------------- Effimaert zum Reinlaufen
local function buildMarket(spec)
	local folder = Instance.new("Folder")
	folder.Name = "Effimaert"
	folder.Parent = workspace

	local base = CFrame.new(spec.cx, 0, spec.cz) * CFrame.Angles(0, spec.yaw, 0)
	local turn = { ["z+"] = 0, ["z-"] = math.pi, ["x+"] = math.pi / 2, ["x-"] = -math.pi / 2 }
	local F = base * CFrame.Angles(0, turn[spec.front], 0) -- Eingangsseite zeigt nach +Z
	local function loc(x, y, z)
		return F * CFrame.new(x, y, z)
	end

	local L, D = spec.w, spec.d
	if string.sub(spec.front, 1, 1) == "x" then
		L, D = spec.d, spec.w
	end
	local T = 2          -- Wanddicke
	local Hg = 18        -- Hoehe Erdgeschoss
	local DW, DH = 16, 13 -- Tuerbreite und -hoehe
	local fy = spec.floorY + 0.2 -- Oberkante Boden
	local top = math.max(spec.floorY + spec.height, fy + Hg + 8)

	local wall = Color3.fromRGB(228, 222, 208)
	local glassC = Color3.fromRGB(150, 190, 210)

	-- Fundament und Boden
	mk(folder, Vector3.new(L, spec.floorY - spec.baseY, D), loc(0, (spec.floorY + spec.baseY) / 2, 0), Color3.fromRGB(120, 120, 120), Enum.Material.Concrete, "Fundament")
	mk(folder, Vector3.new(L - 2 * T, 0.4, D - 2 * T), loc(0, spec.floorY + 0.0, 0), Color3.fromRGB(205, 205, 200), Enum.Material.Pavement, "Boden")

	-- Rueckwand und Seitenwaende
	mk(folder, Vector3.new(L, Hg, T), loc(0, fy + Hg / 2, -D / 2 + T / 2), wall, Enum.Material.Concrete, "Rueckwand")
	mk(folder, Vector3.new(T, Hg, D - 2 * T), loc(-L / 2 + T / 2, fy + Hg / 2, 0), wall, Enum.Material.Concrete, "Seitenwand")
	mk(folder, Vector3.new(T, Hg, D - 2 * T), loc(L / 2 - T / 2, fy + Hg / 2, 0), wall, Enum.Material.Concrete, "Seitenwand")

	-- Frontwand mit zwei Eingaengen (links Migros, rechts Coop)
	local zf = D / 2 - T / 2
	local x1a, x1b = -L / 4 - DW / 2, -L / 4 + DW / 2
	local x2a, x2b = L / 4 - DW / 2, L / 4 + DW / 2
	local function frontPiece(xa, xb, glass)
		local piece = mk(folder, Vector3.new(xb - xa, Hg, T), loc((xa + xb) / 2, fy + Hg / 2, zf), glass and glassC or wall, glass and Enum.Material.Glass or Enum.Material.Concrete, "Front")
		if glass then
			piece.Transparency = 0.5
		end
	end
	frontPiece(-L / 2, x1a, false)
	frontPiece(x1b, x2a, true)
	frontPiece(x2b, L / 2, false)
	for _, xc in ipairs({ -L / 4, L / 4 }) do
		mk(folder, Vector3.new(DW, Hg - DH, T), loc(xc, fy + DH + (Hg - DH) / 2, zf), wall, Enum.Material.Concrete, "Tuersturz")
	end

	-- Obergeschosse als geschlossener Block (zugleich Decke)
	mk(folder, Vector3.new(L, top - (fy + Hg), D), loc(0, (top + fy + Hg) / 2, 0), wall, Enum.Material.Concrete, "Obergeschosse")

	-- Trennwand zwischen den Laeden mit Durchgang
	local gap = 14
	local len = (D - 2 * T - gap) / 2
	mk(folder, Vector3.new(T, Hg, len), loc(0, fy + Hg / 2, -D / 2 + T + len / 2), wall, Enum.Material.Concrete, "Trennwand")
	mk(folder, Vector3.new(T, Hg, len), loc(0, fy + Hg / 2, D / 2 - T - len / 2), wall, Enum.Material.Concrete, "Trennwand")

	-- Deckenlampen
	for lx = -L / 2 + 14, L / 2 - 10, 24 do
		for lz = -D / 2 + 12, D / 2 - 10, 24 do
			local lamp = mk(folder, Vector3.new(8, 0.4, 3), loc(lx, fy + Hg - 0.3, lz), Color3.fromRGB(255, 255, 240), Enum.Material.Neon, "Lampe")
			lamp.CanCollide = false
			local light = Instance.new("PointLight")
			light.Range = 36
			light.Brightness = 1
			light.Parent = lamp
		end
	end

	-- Regale und Kassen
	local shops = {
		{ name = "MIGROS", x0 = -L / 2 + T, x1 = -T / 2, color = Color3.fromRGB(255, 102, 0) },
		{ name = "COOP", x0 = T / 2, x1 = L / 2 - T, color = Color3.fromRGB(237, 28, 36) },
	}
	for _, shop in ipairs(shops) do
		local width = shop.x1 - shop.x0
		local cx = (shop.x0 + shop.x1) / 2
		local half = (width - 10) / 2
		for z = -D / 2 + 14, D / 2 - 36, 13 do
			for _, side in ipairs({ -1, 1 }) do
				local sx = cx + side * (half / 2 + 2.5)
				mk(folder, Vector3.new(half - 1, 7.5, 2.6), loc(sx, fy + 3.75, z), Color3.fromRGB(190, 190, 195), Enum.Material.Metal, "Regal")
				mk(folder, Vector3.new(half - 1, 1.2, 3), loc(sx, fy + 6.6, z), shop.color, Enum.Material.SmoothPlastic, "Regalband")
				mk(folder, Vector3.new(half - 1.5, 1.6, 2.2), loc(sx, fy + 2.6, z), Color3.fromRGB(240, 220, 120), Enum.Material.SmoothPlastic, "Ware")
				mk(folder, Vector3.new(half - 1.5, 1.6, 2.2), loc(sx, fy + 4.6, z), Color3.fromRGB(120, 180, 220), Enum.Material.SmoothPlastic, "Ware")
			end
		end
		for k = -1, 1 do
			mk(folder, Vector3.new(8, 3.6, 4), loc(cx + k * 16, fy + 1.8, D / 2 - 18), Color3.fromRGB(60, 60, 65), Enum.Material.Metal, "Kasse")
			mk(folder, Vector3.new(6, 0.3, 3), loc(cx + k * 16, fy + 3.75, D / 2 - 18), Color3.fromRGB(20, 20, 20), Enum.Material.SmoothPlastic, "Kassenband")
		end
		-- Schild im Laden (an der Rueckwand) und ueber dem Eingang aussen
		sign(folder, shop.name, loc(cx, fy + Hg - 5, -D / 2 + T + 0.6) * CFrame.Angles(0, math.pi, 0), 36, 8, shop.color, Color3.new(1, 1, 1))
		sign(folder, shop.name, loc(cx, fy + Hg + 5, D / 2 + 0.6) * CFrame.Angles(0, math.pi, 0), 40, 9, shop.color, Color3.new(1, 1, 1))
	end
	sign(folder, "EFFIMÄRT", loc(0, fy + Hg + 17, D / 2 + 0.6) * CFrame.Angles(0, math.pi, 0), 70, 12, Color3.fromRGB(60, 60, 70), Color3.new(1, 1, 1))
end

if MARKET then
	buildMarket(MARKET)
end

---------------------------------------------------------------- Fahrbare Mofas
local TuningData = require(script:WaitForChild("TuningData"))
-- Serien-Tempo 50 km/h (Schweizer Mofa-Klasse); Tuningteile aus dem Handy-Shop legen drauf.
local TYPES = {
	{ name = "Ciao", color = Color3.fromRGB(235, 228, 205), maxSpeed = 50, accel = 10, brake = 30, turn = 1.6 },
	{ name = "SI", color = Color3.fromRGB(70, 110, 175), maxSpeed = 53, accel = 12, brake = 32, turn = 1.8 },
	{ name = "Maxi", color = Color3.fromRGB(205, 80, 40), maxSpeed = 56, accel = 14, brake = 34, turn = 2.0 },
}
local DRAG = 6

local function buildMofa(cfg, position)
	local base = CFrame.new(position)
	local model = Instance.new("Model")
	model.Name = cfg.name

	local function newPart(name, size, offset, color, collide, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = base * CFrame.new(offset)
		p.Color = color
		p.Material = Enum.Material.SmoothPlastic
		p.CanCollide = collide
		if shape then
			p.Shape = shape
		end
		p.Parent = model
		return p
	end

	local seat = Instance.new("VehicleSeat")
	seat.Name = "Seat"
	seat.Size = Vector3.new(1.4, 0.5, 2.6)
	seat.CFrame = base * CFrame.new(0, 3.1, 0.7)
	seat.Color = Color3.fromRGB(30, 30, 30)
	seat.CanCollide = false
	seat.MaxSpeed = 0
	seat.Torque = 0
	seat.TurnSpeed = 0
	seat.Parent = model

	model:SetAttribute("MofaTyp", cfg.name)
	model:SetAttribute("Tank", 3)

	local wheelPhys = PhysicalProperties.new(0.7, 0, 0, 1, 1)
	local parts = {
		newPart("Rahmen", Vector3.new(0.6, 0.6, 5), Vector3.new(0, 2.2, 0), cfg.color, false),
		newPart("Lenker", Vector3.new(2.4, 0.3, 0.3), Vector3.new(0, 3.9, -2.0), Color3.fromRGB(60, 60, 60), false),
		newPart("Gabel", Vector3.new(0.3, 2.6, 0.3), Vector3.new(0, 2.5, -2.0), Color3.fromRGB(80, 80, 80), false),
		newPart("Tank", Vector3.new(0.9, 0.8, 1.6), Vector3.new(0, 3.2, -0.9), cfg.color, false),
		newPart("ZylinderBlock", Vector3.new(1.3, 1.3, 1.6), Vector3.new(0.9, 2.0, 0.3), Color3.fromRGB(150, 150, 155), false),
		newPart("Vergaser", Vector3.new(0.5, 0.6, 0.9), Vector3.new(0.9, 1.9, 1.1), Color3.fromRGB(120, 120, 125), false),
		newPart("Filter", Vector3.new(0.9, 0.9, 0.9), Vector3.new(1.0, 2.0, 1.7), Color3.fromRGB(230, 230, 220), false),
		newPart("AuspuffRohr", Vector3.new(0.7, 0.7, 2.6), Vector3.new(0.7, 1.3, 1.5), Color3.fromRGB(190, 190, 195), false),
	}
	if cfg.roller then
		table.insert(parts, newPart("Trittbrett", Vector3.new(3.6, 0.4, 5.2), Vector3.new(0, 1.6, -0.4), cfg.color, false))
		table.insert(parts, newPart("Lenkerschild", Vector3.new(3.4, 3.2, 0.3), Vector3.new(0, 4.3, -2.2), cfg.color, false))
	end
	for _, offsetZ in ipairs({ -2.2, 2.1 }) do
		local wheel = newPart("Rad", Vector3.new(0.5, 2.2, 2.2), Vector3.new(0, 1.1, offsetZ), Color3.fromRGB(25, 25, 25), true, Enum.PartType.Cylinder)
		wheel.CustomPhysicalProperties = wheelPhys
		table.insert(parts, wheel)
	end
	for _, p in ipairs(parts) do
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = seat
		weld.Part1 = p
		weld.Parent = p
	end
	model.PrimaryPart = seat

	local attachment = Instance.new("Attachment")
	attachment.Parent = seat
	local upright = Instance.new("AlignOrientation")
	upright.Mode = Enum.OrientationAlignmentMode.OneAttachment
	upright.AlignType = Enum.AlignType.AllAxes
	upright.CFrame = CFrame.new()
	upright.Attachment0 = attachment
	upright.MaxTorque = 1e7
	upright.Responsiveness = 40
	upright.Parent = seat

	model.Parent = workspace
	seat:SetNetworkOwner(nil)

	-- Tuning-Werte werden neu berechnet, sobald im Handy-Shop ein Teil eingebaut wird.
	local live = TuningData.calc(cfg, {})
	local function recompute()
		live = TuningData.calc(cfg, {
			vergaser = model:GetAttribute("vergaser"),
			zylinder = model:GetAttribute("zylinder"),
			luftfilter = model:GetAttribute("luftfilter"),
			auspuff = model:GetAttribute("auspuff"),
		})
	end
	for _, attr in ipairs({ "vergaser", "zylinder", "luftfilter", "auspuff" }) do
		model:GetAttributeChangedSignal(attr):Connect(recompute)
	end

	-- Motorsound: Lautstaerke und Tonhoehe wachsen mit dem Tuning. SoundId ist absichtlich leer,
	-- da ich keinen lizenzfreien Motorsound mitliefern kann - trag in Studio eine eigene SoundId ein.
	local engineSound = Instance.new("Sound")
	engineSound.Name = "Motor"
	engineSound.Looped = true
	engineSound.Volume = 0
	engineSound.Parent = seat
	engineSound:Play()

	-- Tankanzeige ueber dem Mofa (Elektro zeigt Batterie)
	local tankGui = Instance.new("BillboardGui")
	tankGui.Size = UDim2.fromOffset(110, 30)
	tankGui.StudsOffset = Vector3.new(0, 4.5, 0)
	tankGui.MaxDistance = 80
	tankGui.Parent = seat
	local tankLbl = Instance.new("TextLabel")
	tankLbl.Size = UDim2.fromScale(1, 1)
	tankLbl.BackgroundTransparency = 0.35
	tankLbl.BackgroundColor3 = Color3.fromRGB(20, 20, 24)
	tankLbl.TextColor3 = Color3.fromRGB(140, 230, 150)
	tankLbl.Font = Enum.Font.GothamBold
	tankLbl.TextSize = 14
	tankLbl.Text = cfg.electric and "🔋 Elektro" or "⛽ 3.0 L"
	tankLbl.Parent = tankGui

	local speed = 0
	local lastTankShown = 3
	RunService.Heartbeat:Connect(function(dt)
		if not seat.Parent then
			return
		end
		local throttle = seat.ThrottleFloat
		local steer = seat.SteerFloat
		if seat.Occupant == nil then
			throttle, steer = 0, 0
		end
		local tank = model:GetAttribute("Tank") or 0
		if not cfg.electric then
			if tank > 0 then
				local verbrauch = (0.0022 + live.soundScore * 0.00025) * math.clamp(speed / live.maxSpeed, 0, 1)
				if seat.Occupant then
					verbrauch += 0.0004
				end
				tank = math.max(tank - verbrauch * dt, 0)
				model:SetAttribute("Tank", tank)
			end
			if tank <= 0 then
				speed = 0 -- Tank leer: Motor aus, erst wieder nach dem Tanken
			end
		end
		if math.abs(tank - lastTankShown) > 0.05 or (tank == 0 and lastTankShown ~= 0) then
			lastTankShown = tank
			if cfg.electric then
				tankLbl.Text = "🔋 Elektro"
				tankLbl.TextColor3 = Color3.fromRGB(140, 200, 255)
			else
				tankLbl.Text = ("⛽ %.1f L"):format(tank)
				tankLbl.TextColor3 = tank < 0.5 and Color3.fromRGB(255, 90, 70) or Color3.fromRGB(140, 230, 150)
			end
		end
		if throttle > 0 then
			speed = math.min(speed + live.accel * throttle * dt, live.maxSpeed)
		elseif throttle < 0 then
			speed = math.max(speed - live.brake * dt, 0)
		else
			speed = math.max(speed - DRAG * dt, 0)
		end
		local look = seat.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude >= 0.01 then
			flat = flat.Unit
			local v = seat.AssemblyLinearVelocity
			seat.AssemblyLinearVelocity = flat * speed + Vector3.new(0, v.Y, 0)
			local turnFactor = math.clamp(speed / 8, 0, 1)
			seat.AssemblyAngularVelocity = Vector3.new(0, -steer * live.turn * turnFactor, 0)
		end
		-- Wheelie: Shift halten bei Gas und ueber 12 km/h kippt das Toeffli nach hinten
		if flat.Magnitude > 0.05 then
			local wheelieAktiv = model:GetAttribute("Wheelie") == true
				and seat.Occupant ~= nil and throttle > 0 and speed > 12
			local pitch = wheelieAktiv and math.rad(24) or 0
			upright.CFrame = CFrame.lookAt(Vector3.zero, flat) * CFrame.Angles(pitch, 0, 0)
		end
		local loud = math.clamp(live.soundScore / 20, 0, 1) -- 0 Serie, 1 Vollausbau
		engineSound.Volume = (0.15 + loud * 0.5) * math.clamp(speed / live.maxSpeed, 0.15, 1)
		engineSound.PlaybackSpeed = 0.8 + (speed / live.maxSpeed) * 0.9 + loud * 0.3
	end)
	return model
end

for i, cfg in ipairs(TYPES) do
	local x, z = (i - 2) * 7, 26
	buildMofa(cfg, Vector3.new(x, heightAt(x, z) + 0.5, z))
end

---------------------------------------------------------------- Toeffli per Handy spawnen (gratis)
local SPAWN_TYPES = {
	{ name = "Ciao", color = Color3.fromRGB(235, 228, 205), maxSpeed = 50, accel = 10, brake = 30, turn = 1.6 },
	{ name = "Puch Maxi", color = Color3.fromRGB(45, 85, 45), maxSpeed = 56, accel = 14, brake = 34, turn = 2.0 },
	{ name = "Piaggio Fly", color = Color3.fromRGB(70, 130, 190), maxSpeed = 80, accel = 13, brake = 30, turn = 2.4, roller = true },
	{ name = "Piaggio SI", color = Color3.fromRGB(70, 110, 175), maxSpeed = 53, accel = 12, brake = 32, turn = 1.8, price = 150 },
	{ name = "Kukirin G4", color = Color3.fromRGB(40, 40, 45), maxSpeed = 70, accel = 18, brake = 40, turn = 2.6, roller = true, electric = true, price = 500 },
}
local playerMofas = {}
spawnMofaFunc = function(player, typ)
	local cfg
	for _, c in ipairs(SPAWN_TYPES) do
		if string.lower(c.name) == string.lower(tostring(typ)) then
			cfg = c
			break
		end
	end
	if not cfg then
		return "Unbekanntes Toeffli."
	end
	local char = player.Character
	if not char or not char.PrimaryPart then
		return "Du bist noch nicht gespawnt."
	end
	if cfg.price and cfg.price > 0 then
		local ok, bezahlt = pcall(function()
			return geldFrage:Invoke(player, cfg.price)
		end)
		if not ok or not bezahlt then
			return ("Nicht genug Geld: %s kostet CHF %d."):format(cfg.name, cfg.price)
		end
	end
	local list = playerMofas[player.UserId] or {}
	playerMofas[player.UserId] = list
	if #list >= 2 then
		local old = table.remove(list, 1)
		if old and old.Parent then
			old:Destroy()
		end
	end
	local pos = char.PrimaryPart.Position
	local sx, sz = pos.X + 9, pos.Z + 9
	local model = buildMofa(cfg, Vector3.new(sx, heightAt(sx, sz) + 0.5, sz))
	table.insert(list, model)
	return cfg.name .. " gespawnt. Viel Spass!"
end
for _, q in ipairs(spawnQueue) do
	spawnMofaFunc(q[1], q[2])
end
spawnQueue = nil

-- Startpunkt direkt neben den Mofas setzen (vorher stand er am Ursprung)
local startSpawn = workspace:FindFirstChild("SpawnLocation", true)
if startSpawn then
	local sx, sz = 0, 20
	startSpawn.CFrame = CFrame.new(sx, heightAt(sx, sz) + 0.6, sz)
end

---------------------------------------------------------------- Jobs: Doenerladen und Mofakult-Fabrik
local function giveCarryTool(player, name, handleSize, handleColor, extraBuilder)
	if player.Backpack:FindFirstChild(name) or (player.Character and player.Character:FindFirstChild(name)) then
		return false
	end
	local tool = Instance.new("Tool")
	tool.Name = name
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = handleSize
	handle.Color = handleColor
	handle.Material = Enum.Material.SmoothPlastic
	handle.Parent = tool
	if extraBuilder then
		extraBuilder(tool, handle)
	end
	tool.Parent = player.Backpack
	return true
end

local function popup(part, text, color)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(240, 54)
	bb.StudsOffset = Vector3.new(0, 7, 0)
	bb.AlwaysOnTop = true
	bb.Parent = part
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.TextColor3 = color
	lbl.TextStrokeTransparency = 0.2
	lbl.Font = Enum.Font.GothamBlack
	lbl.TextScaled = true
	lbl.Parent = bb
	task.delay(2.5, function()
		bb:Destroy()
	end)
end

local function buildLieferPad(name, x, z, color, labelText, itemName, pay)
	local y = heightAt(x, z)
	local pad = mk(workspace, Vector3.new(16, 0.4, 16), CFrame.new(x, y + 0.25, z), color, Enum.Material.Neon, name)
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = labelText
	prompt.ObjectText = name
	prompt.HoldDuration = 0.5
	prompt.MaxActivationDistance = 14
	prompt.Parent = pad
	prompt.Triggered:Connect(function(player)
		local tool = player.Backpack:FindFirstChild(itemName) or (player.Character and player.Character:FindFirstChild(itemName))
		if tool then
			tool:Destroy()
			jobGeld:Fire(player, pay)
			popup(pad, "+CHF " .. pay, Color3.fromRGB(120, 230, 140))
		else
			popup(pad, "Du hast nichts zum Abgeben.", Color3.fromRGB(255, 200, 90))
		end
	end)
	return pad
end

local DOENER_POS = { 500, 0 }
local FABRIK_POS = { -1000, 2000 }

local function buildDoenerladen(x, z)
	local y = heightAt(x, z)
	local folder = Instance.new("Folder")
	folder.Name = "Doenerladen"
	folder.Parent = workspace
	local W, D, H = 44, 30, 13
	local wallC = Color3.fromRGB(235, 220, 190)
	local y0 = y + 0.2
	mk(folder, Vector3.new(W, 0.4, D), CFrame.new(x, y0 + 0.2, z), Color3.fromRGB(180, 175, 168), Enum.Material.Concrete, "Boden")
	mk(folder, Vector3.new(W, H, 1.2), CFrame.new(x, y0 + H / 2, z - D / 2), wallC, Enum.Material.Wood, "Wand-Nord")
	mk(folder, Vector3.new(W, H, 1.2), CFrame.new(x, y0 + H / 2, z + D / 2), wallC, Enum.Material.Wood, "Wand-Sued")
	mk(folder, Vector3.new(1.2, H, D), CFrame.new(x + W / 2, y0 + H / 2, z), wallC, Enum.Material.Wood, "Wand-Ost")
	-- Front (West, zum Bahnhof) mit Tuer in der Mitte und zwei Fenstern
	mk(folder, Vector3.new(1.2, H, 3), CFrame.new(x - W / 2, y0 + H / 2, z - 13.5), wallC, Enum.Material.Wood, "Front")
	mk(folder, Vector3.new(1.2, H, 3), CFrame.new(x - W / 2, y0 + H / 2, z + 13.5), wallC, Enum.Material.Wood, "Front")
	for _, zs in ipairs({ -8, 8 }) do
		mk(folder, Vector3.new(1.2, 5, 8), CFrame.new(x - W / 2, y0 + 2.5, z + zs), wallC, Enum.Material.Wood, "Fensterbank")
		local glas = mk(folder, Vector3.new(1.2, 5, 8), CFrame.new(x - W / 2, y0 + 7.5, z + zs), Color3.fromRGB(150, 190, 210), Enum.Material.Glass, "Fenster")
		glas.Transparency = 0.5
		mk(folder, Vector3.new(1.2, 3, 8), CFrame.new(x - W / 2, y0 + 11.5, z + zs), wallC, Enum.Material.Wood, "Sturz")
	end
	mk(folder, Vector3.new(1.2, 3, 6), CFrame.new(x - W / 2, y0 + 11.5, z), wallC, Enum.Material.Wood, "Tuersturz")
	mk(folder, Vector3.new(W + 2, 1, D + 2), CFrame.new(x, y0 + H + 0.5, z), Color3.fromRGB(90, 60, 50), Enum.Material.Slate, "Dach")
	local innen = Instance.new("PointLight")
	innen.Range = 40
	innen.Brightness = 1.2
