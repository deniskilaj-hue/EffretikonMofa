]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBX10335"><Properties><string name="Name">HandySkript</string><ProtectedString name="Source"><![CDATA[-- HandySkript: laeuft im Töffli-Handy. Oeffnet beim Aktivieren eine Shop/Inventar/Karte-Oberflaeche.
-- Das Handy laesst sich auch ohne Werkzeug oeffnen: mit der Taste P oder dem Handy-Knopf oben rechts.
local tool = script.Parent
local player = game:GetService("Players").LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local remotes = ReplicatedStorage:WaitForChild("TuningRemotes")
local KartenDaten = require(ReplicatedStorage:WaitForChild("KartenDaten"))
local buyEvent = remotes:WaitForChild("KaufTeil")
local installEvent = remotes:WaitForChild("TeilEinbauen")
local invUpdated = remotes:WaitForChild("InventarAktualisiert")
local getInvFn = remotes:WaitForChild("HoleInventar")
local getPartsFn = remotes:WaitForChild("HoleTeileliste")
local mofaSpawnFn = remotes:WaitForChild("MofaSpawnen")
local wheelieEvent = remotes:WaitForChild("Wheelie")
local oeffneShop = remotes:WaitForChild("OeffneShop")
local UIS = game:GetService("UserInputService")

local CATS = { "vergaser", "zylinder", "luftfilter", "auspuff" }
local LABEL = { vergaser = "Vergaser", zylinder = "Zylinder", luftfilter = "Luftfilter", auspuff = "Auspuff" }

local PARTS = getPartsFn:InvokeServer()
local inventory = getInvFn:InvokeServer()

local gui = Instance.new("ScreenGui")
gui.Name = "HandyApp"
gui.ResetOnSpawn = false
gui.Enabled = false
gui.IgnoreGuiInset = true
local playerGui = player:WaitForChild("PlayerGui")
local alteGui = playerGui:FindFirstChild("HandyApp")
if alteGui then
	alteGui:Destroy()
end
gui.Parent = playerGui

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(460, 520)
frame.Position = UDim2.new(0.5, -230, 0.5, -260)
frame.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
frame.BorderSizePixel = 0
frame.Parent = gui
local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 18); corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 46)
title.BackgroundTransparency = 1
title.Text = "🛵 Töffli-Handy"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBlack
title.TextSize = 22
title.Parent = frame

local geldLbl = Instance.new("TextLabel")
geldLbl.Size = UDim2.new(0, 130, 0, 46)
geldLbl.Position = UDim2.new(1, -180, 0, 0)
geldLbl.BackgroundTransparency = 1
geldLbl.Text = ""
geldLbl.TextColor3 = Color3.fromRGB(140, 230, 150)
geldLbl.Font = Enum.Font.GothamBold
geldLbl.TextSize = 18
geldLbl.TextXAlignment = Enum.TextXAlignment.Right
geldLbl.Parent = frame
task.spawn(function()
	local ls = player:WaitForChild("leaderstats")
	local g = ls:WaitForChild("Geld")
	local function upd()
		geldLbl.Text = "CHF " .. g.Value
	end
	g.Changed:Connect(upd)
	upd()
end)

local closeBtn = Instance.new("TextButton")
closeBtn.Size = UDim2.fromOffset(32, 32)
closeBtn.Position = UDim2.new(1, -40, 0, 8)
closeBtn.Text = "✕"
closeBtn.TextColor3 = Color3.new(1, 1, 1)
closeBtn.BackgroundColor3 = Color3.fromRGB(60, 60, 66)
closeBtn.Font = Enum.Font.GothamBold
closeBtn.Parent = frame
Instance.new("UICorner", closeBtn).CornerRadius = UDim.new(1, 0)
closeBtn.MouseButton1Click:Connect(function() gui.Enabled = false end)

local tabBar = Instance.new("Frame")
tabBar.Size = UDim2.new(1, -20, 0, 36)
tabBar.Position = UDim2.new(0, 10, 0, 48)
tabBar.BackgroundTransparency = 1
tabBar.Parent = frame
local tabLayout = Instance.new("UIListLayout", tabBar)
tabLayout.FillDirection = Enum.FillDirection.Horizontal
tabLayout.Padding = UDim.new(0, 8)

local shopTab = Instance.new("TextButton")
shopTab.Size = UDim2.fromOffset(138, 36)
shopTab.Text = "Shop"
shopTab.Parent = tabBar
local spawnTab = shopTab:Clone()
spawnTab.Text = "Töffli"
spawnTab.Parent = tabBar
local invTab = shopTab:Clone()
invTab.Text = "Inventar"
invTab.Parent = tabBar
local mapTab = shopTab:Clone()
mapTab.Text = "Karte"
mapTab.Parent = tabBar
for _, b in ipairs({ shopTab, spawnTab, invTab, mapTab }) do
	b.Font = Enum.Font.GothamBold
	b.TextColor3 = Color3.new(1, 1, 1)
	b.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 10)
end

local status = Instance.new("TextLabel")
status.Size = UDim2.new(1, -20, 0, 22)
status.Position = UDim2.new(0, 10, 0, 90)
status.BackgroundTransparency = 1
status.TextColor3 = Color3.fromRGB(120, 230, 140)
status.Font = Enum.Font.Gotham
status.TextSize = 14
status.Text = ""
status.Parent = frame

local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1, -20, 1, -126)
scroll.Position = UDim2.new(0, 10, 0, 116)
scroll.BackgroundTransparency = 1
scroll.ScrollBarThickness = 6
scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
scroll.Parent = frame
local layout = Instance.new("UIListLayout", scroll)
layout.Padding = UDim.new(0, 8)

local mode = "shop"

---------------------------------------------------------------- Live-Karte (Tab "Karte")
local mapFrame = Instance.new("Frame")
mapFrame.Size = UDim2.new(1, -20, 1, -126)
mapFrame.Position = UDim2.new(0, 10, 0, 116)
mapFrame.BackgroundColor3 = Color3.fromRGB(34, 42, 34)
mapFrame.BorderSizePixel = 0
mapFrame.ClipsDescendants = true
mapFrame.Visible = false
mapFrame.Parent = frame
local mapCorner = Instance.new("UICorner")
mapCorner.CornerRadius = UDim.new(0, 10)
mapCorner.Parent = mapFrame

local MAP_W = 440
local MAP_H = 378
local BOUNDS = { x0 = -1700, x1 = 5940, z0 = -1815, z1 = 7035 }
local mapScale = math.min(MAP_W / (BOUNDS.x1 - BOUNDS.x0), MAP_H / (BOUNDS.z1 - BOUNDS.z0))
local mapOffX = (MAP_W - (BOUNDS.x1 - BOUNDS.x0) * mapScale) / 2
local mapOffZ = (MAP_H - (BOUNDS.z1 - BOUNDS.z0) * mapScale) / 2

local function mapPx(x, z)
	return mapOffX + (x - BOUNDS.x0) * mapScale, mapOffZ + (z - BOUNDS.z0) * mapScale
end

local WALD = { { 2950, 3560, 3950, 4560 }, { 2650, 2950, 3650, 3950 }, { 2350, 2650, 3400, 3650 } }
local POIS = {
	{ name = "Bahnhof", x = 0, z = 20, farbe = Color3.fromRGB(80, 160, 255) },
	{ name = "Effimärt", x = -361, z = -1144, farbe = Color3.fromRGB(255, 90, 90) },
	{ name = "Dönerladen", x = 500, z = 0, farbe = Color3.fromRGB(255, 160, 60) },
	{ name = "Mofakult", x = -1000, z = 2000, farbe = Color3.fromRGB(255, 120, 30) },
	{ name = "SOCAR", x = -2000, z = 200, farbe = Color3.fromRGB(60, 200, 120) },
	{ name = "Töfflitreffen", x = 2846, z = 5367, farbe = Color3.fromRGB(250, 220, 80) },
	{ name = "Werkstatt", x = 2800, z = 5321, farbe = Color3.fromRGB(200, 200, 210) },
}

local mapBuilt = false
local duMarker, coordsLbl

local function buildMap()
	if mapBuilt then
		return
	end
	mapBuilt = true
	for _, w in ipairs(WALD) do
		local px, py = mapPx(w[1], w[3])
		local r = Instance.new("Frame")
		r.BorderSizePixel = 0
		r.BackgroundColor3 = Color3.fromRGB(30, 70, 35)
		r.BackgroundTransparency = 0.35
		r.Position = UDim2.fromOffset(px, py)
		r.Size = UDim2.fromOffset((w[2] - w[1]) * mapScale, (w[4] - w[3]) * mapScale)
		r.Parent = mapFrame
	end
	for _, r in ipairs(KartenDaten.ROADS) do
		local px, py = mapPx(r[1], r[2])
		local seg = Instance.new("Frame")
		seg.AnchorPoint = Vector2.new(0.5, 0.5)
		seg.BorderSizePixel = 0
		seg.BackgroundColor3 = Color3.fromRGB(105, 105, 112)
		seg.Position = UDim2.fromOffset(px, py)
		seg.Size = UDim2.fromOffset(math.max(r[3] * mapScale, 1), math.max(r[4] * mapScale, 1))
		seg.Rotation = r[5]
		seg.Parent = mapFrame
	end
	for _, h in ipairs(KartenDaten.HAEUSER) do
		local px, py = mapPx(h[1], h[2])
		local dot = Instance.new("Frame")
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.BorderSizePixel = 0
		dot.BackgroundColor3 = Color3.fromRGB(205, 192, 168)
		dot.Position = UDim2.fromOffset(px, py)
		dot.Size = UDim2.fromOffset(math.max(h[3] * mapScale, 2), math.max(h[4] * mapScale, 2))
		dot.Parent = mapFrame
	end
	for _, poi in ipairs(POIS) do
		local px, py = mapPx(poi.x, poi.z)
		local dot = Instance.new("Frame")
		dot.AnchorPoint = Vector2.new(0.5, 0.5)
		dot.BorderSizePixel = 0
		dot.BackgroundColor3 = poi.farbe
		dot.Position = UDim2.fromOffset(px, py)
		dot.Size = UDim2.fromOffset(7, 7)
		dot.Parent = mapFrame
		local dc = Instance.new("UICorner")
		dc.CornerRadius = UDim.new(1, 0)
		dc.Parent = dot
		local lbl = Instance.new("TextLabel")
		lbl.BackgroundTransparency = 1
		lbl.Text = poi.name
		lbl.TextColor3 = Color3.new(1, 1, 1)
		lbl.Font = Enum.Font.GothamBold
		lbl.TextSize = 10
		lbl.Position = UDim2.fromOffset(px + 6, py - 7)
		lbl.Size = UDim2.fromOffset(100, 14)
		lbl.TextXAlignment = Enum.TextXAlignment.Left
		lbl.Parent = mapFrame
	end
	duMarker = Instance.new("Frame")
	duMarker.AnchorPoint = Vector2.new(0.5, 0.5)
	duMarker.BackgroundColor3 = Color3.fromRGB(255, 60, 60)
	duMarker.BorderSizePixel = 0
	duMarker.Size = UDim2.fromOffset(11, 11)
	duMarker.ZIndex = 5
	duMarker.Parent = mapFrame
	local duc = Instance.new("UICorner")
	duc.CornerRadius = UDim.new(1, 0)
	duc.Parent = duMarker
	local duLbl = Instance.new("TextLabel")
	duLbl.BackgroundTransparency = 1
	duLbl.Text = "DU"
	duLbl.TextColor3 = Color3.fromRGB(255, 120, 120)
	duLbl.Font = Enum.Font.GothamBlack
	duLbl.TextSize = 10
	duLbl.Position = UDim2.new(0, 0, 0, -14)
	duLbl.Size = UDim2.fromOffset(11, 12)
	duLbl.ZIndex = 5
	duLbl.Parent = duMarker
	coordsLbl = Instance.new("TextLabel")
	coordsLbl.BackgroundTransparency = 1
	coordsLbl.Text = ""
	coordsLbl.TextColor3 = Color3.fromRGB(180, 230, 180)
	coordsLbl.Font = Enum.Font.Gotham
	coordsLbl.TextSize = 12
	coordsLbl.Position = UDim2.new(0, 8, 1, -22)
	coordsLbl.Size = UDim2.new(1, -16, 0, 16)
	coordsLbl.TextXAlignment = Enum.TextXAlignment.Left
	coordsLbl.ZIndex = 5
	coordsLbl.Parent = mapFrame
end

local liveConn
local function setLiveMarker(aktiv)
	if liveConn then
		liveConn:Disconnect()
		liveConn = nil
	end
	if aktiv and duMarker then
		liveConn = game:GetService("RunService").RenderStepped:Connect(function()
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp and duMarker then
				local px, py = mapPx(hrp.Position.X, hrp.Position.Z)
				duMarker.Position = UDim2.fromOffset(px, py)
				coordsLbl.Text = ("X %d · Z %d"):format(math.floor(hrp.Position.X + 0.5), math.floor(hrp.Position.Z + 0.5))
			end
		end)
	end
end

local SPAWNABLE = {
	{ name = "Ciao", sub = "Gratis · 50 km/h · Klassiker", price = 0 },
	{ name = "Puch Maxi", sub = "Gratis · 56 km/h · spritzig", price = 0 },
	{ name = "Piaggio Fly", sub = "Gratis · 80 km/h · Roller · Jasons Italo-Kiste", price = 0 },
	{ name = "Piaggio SI", sub = "CHF 150 · 53 km/h · Tuningteile vorhanden", price = 150 },
	{ name = "Kukirin G4", sub = "CHF 500 · E-Scooter · 70 km/h · kein Tank", price = 500 },
}

local function setStatus(text)
	status.Text = text or ""
	if text then
		task.delay(3, function()
			if status.Text == text then status.Text = "" end
		end)
	end
end

local function sectionHeader(text)
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 0, 28)
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.TextXAlignment = Enum.TextXAlignment.Left
	lbl.TextColor3 = Color3.fromRGB(240, 200, 60)
	lbl.Font = Enum.Font.GothamBlack
	lbl.TextSize = 16
	lbl.Parent = scroll
end

local function row(nameText, subText, buttonText, onClick, buttonColor)
	local card = Instance.new("Frame")
	card.Size = UDim2.new(1, 0, 0, 56)
	card.BackgroundColor3 = Color3.fromRGB(42, 42, 48)
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)
	card.Parent = scroll

	local nameLbl = Instance.new("TextLabel")
	nameLbl.Size = UDim2.new(1, -110, 0, 26)
	nameLbl.Position = UDim2.new(0, 12, 0, 4)
	nameLbl.BackgroundTransparency = 1
	nameLbl.Text = nameText
	nameLbl.TextXAlignment = Enum.TextXAlignment.Left
	nameLbl.TextColor3 = Color3.new(1, 1, 1)
	nameLbl.Font = Enum.Font.GothamBold
	nameLbl.TextSize = 14
	nameLbl.Parent = card

	local subLbl = Instance.new("TextLabel")
	subLbl.Size = UDim2.new(1, -110, 0, 20)
	subLbl.Position = UDim2.new(0, 12, 0, 28)
	subLbl.BackgroundTransparency = 1
	subLbl.Text = subText
	subLbl.TextXAlignment = Enum.TextXAlignment.Left
	subLbl.TextColor3 = Color3.fromRGB(180, 180, 190)
	subLbl.Font = Enum.Font.Gotham
	subLbl.TextSize = 12
	subLbl.Parent = card

	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(90, 40)
	btn.Position = UDim2.new(1, -100, 0.5, -20)
	btn.Text = buttonText
	btn.Font = Enum.Font.GothamBold
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.BackgroundColor3 = buttonColor or Color3.fromRGB(70, 140, 220)
	Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
	btn.Parent = card
	btn.MouseButton1Click:Connect(onClick)
	return card
end

local function clearScroll()
	for _, c in ipairs(scroll:GetChildren()) do
		if not c:IsA("UIListLayout") then
			c:Destroy()
		end
	end
end

local function render()
	clearScroll()
	if mode == "karte" then
		scroll.Visible = false
		mapFrame.Visible = true
		buildMap()
		setLiveMarker(true)
		return
	end
	scroll.Visible = true
	mapFrame.Visible = false
	setLiveMarker(false)
	if mode == "shop" then
		for _, cat in ipairs(CATS) do
			sectionHeader(LABEL[cat])
			for _, part in ipairs(PARTS[cat]) do
				if part.stock then
					row(part.name, "Ab Werk verbaut", "Serie", function() end, Color3.fromRGB(70, 70, 76))
				else
					local owned = inventory[part.id] or 0
					local fits = part.fits and (" · nur " .. table.concat(part.fits, "/")) or ""
					row(part.name, ("CHF %d · +%d km/h · Lautstärke %d/5%s · besitzt: %d"):format(part.price, part.speed, part.sound, fits, owned),
						"Kaufen", function()
							buyEvent:FireServer(cat, part.id)
						end)
				end
			end
		end
	elseif mode == "toeffli" then
		sectionHeader("Gratis-Töffli (spawnt neben dir)")
		for _, t in ipairs(SPAWNABLE) do
			row(t.name, t.sub, t.price > 0 and "Kaufen" or "Spawnen", function()
				local ok, msg = pcall(function()
					return mofaSpawnFn:InvokeServer(t.name)
				end)
				setStatus(ok and msg or "Fehler beim Spawnen.")
			end, Color3.fromRGB(60, 170, 90))
		end
		sectionHeader("Max. 2 gespawnte Töffli pro Spieler")
	else
		local any = false
		for _, cat in ipairs(CATS) do
			for _, part in ipairs(PARTS[cat]) do
				local owned = inventory[part.id] or 0
				if owned > 0 then
					any = true
					row(part.name, LABEL[cat] .. " · besitzt: " .. owned, "Einbauen", function()
						installEvent:FireServer(cat, part.id)
					end, Color3.fromRGB(60, 170, 90))
				end
			end
		end
		if not any then
			sectionHeader("Noch nichts gekauft")
		end
	end
end

shopTab.MouseButton1Click:Connect(function() mode = "shop"; render() end)
spawnTab.MouseButton1Click:Connect(function() mode = "toeffli"; render() end)
invTab.MouseButton1Click:Connect(function() mode = "inventar"; render() end)
mapTab.MouseButton1Click:Connect(function() mode = "karte"; render() end)

invUpdated.OnClientEvent:Connect(function(inv, msg)
	inventory = inv
	render()
	if msg then
		setStatus(msg)
	end
end)

tool.Activated:Connect(function()
	gui.Enabled = not gui.Enabled
	if gui.Enabled then
		render()
	end
end)

tool.Equipped:Connect(function()
	inventory = getInvFn:InvokeServer()
end)
tool.Unequipped:Connect(function()
	gui.Enabled = false
end)

---------------------------------------------------------------- Handy-Knopf (immer sichtbar) und Taste P
local alterKnopf = playerGui:FindFirstChild("HandyKnopf")
if alterKnopf then
	alterKnopf:Destroy()
end
local knopfGui = Instance.new("ScreenGui")
knopfGui.Name = "HandyKnopf"
knopfGui.ResetOnSpawn = false
knopfGui.Parent = playerGui
local knopf = Instance.new("TextButton")
knopf.Size = UDim2.fromOffset(44, 44)
knopf.Position = UDim2.new(1, -54, 0, 8)
knopf.Text = "\u{1F4F1}"
knopf.TextSize = 22
knopf.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
knopf.BackgroundTransparency = 0.25
knopf.TextColor3 = Color3.new(1, 1, 1)
knopf.Font = Enum.Font.GothamBold
knopf.Parent = knopfGui
local knopfCorner = Instance.new("UICorner")
knopfCorner.CornerRadius = UDim.new(1, 0)
knopfCorner.Parent = knopf
knopf.MouseButton1Click:Connect(function()
	gui.Enabled = not gui.Enabled
	if gui.Enabled then
		render()
	end
end)

UIS.InputBegan:Connect(function(input, gp)
	if gp then
		return
	end
	if input.KeyCode == Enum.KeyCode.P then
		gui.Enabled = not gui.Enabled
		if gui.Enabled then
			render()
		end
	end
end)

UIS.InputBegan:Connect(function(input, gp)
	if input.KeyCode == Enum.KeyCode.LeftShift then
		wheelieEvent:FireServer(true)
	end
end)
UIS.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.LeftShift then
		wheelieEvent:FireServer(false)
	end
end)

oeffneShop.OnClientEvent:Connect(function()
	mode = "shop"
	gui.Enabled = true
	render()
end)

render()
]]></ProtectedString></Properties></Item><Item class="LocalScript" referent="RBXSPAWN1"><Properties><string name="Name">SpawnAuswahl</string><bool name="Disabled">true</bool><ProtectedString name="Source"><![CDATA[-- SpawnAuswahl: beim Beitritt Spawnpunkt waehlen (Bahnhof, Garage Bisikon, Mofakult-Fabrik).
local player = game:GetService("Players").LocalPlayer
local remotes = game:GetService("ReplicatedStorage"):WaitForChild("TuningRemotes")
local waehleSpawn = remotes:WaitForChild("WaehleSpawn")

local gui = Instance.new("ScreenGui")
gui.Name = "SpawnAuswahlGui"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.DisplayOrder = 50
gui.Parent = player:WaitForChild("PlayerGui")

local dim = Instance.new("Frame")
dim.Size = UDim2.fromScale(1, 1)
dim.BackgroundColor3 = Color3.fromRGB(10, 10, 14)
dim.BackgroundTransparency = 0.35
dim.Parent = gui

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(420, 300)
frame.Position = UDim2.new(0.5, -210, 0.5, -150)
frame.BackgroundColor3 = Color3.fromRGB(28, 28, 32)
frame.BorderSizePixel = 0
frame.Parent = dim
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 16)
corner.Parent = frame

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 60)
title.BackgroundTransparency = 1
title.Text = "Wo willst du spawnen?"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBlack
title.TextSize = 24
title.Parent = frame

local layout = Instance.new("UIListLayout")
layout.Padding = UDim.new(0, 12)
layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
layout.Parent = frame

local ORTE = {
	{ "Bahnhof Effretikon", "Mofas, Dönerladen, Effimärt" },
	{ "Garage Bisikon (Werkstatt)", "Töfflitreffen, grosse Garage" },
	{ "Mofakult-Fabrik", "Teile-Shop und Liefer-Jobs" },
}

for i, ort in ipairs(ORTE) do
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.fromOffset(360, 62)
	btn.BackgroundColor3 = Color3.fromRGB(50, 50, 58)
	btn.Text = ""
	btn.Parent = frame
	local bc = Instance.new("UICorner")
	bc.CornerRadius = UDim.new(0, 10)
	bc.Parent = btn
	local name = Instance.new("TextLabel")
	name.Size = UDim2.new(1, -16, 0, 30)
	name.Position = UDim2.new(0, 8, 0, 4)
	name.BackgroundTransparency = 1
	name.Text = ort[1]
	name.TextColor3 = Color3.new(1, 1, 1)
	name.Font = Enum.Font.GothamBold
	name.TextSize = 18
	name.TextXAlignment = Enum.TextXAlignment.Left
	name.Parent = btn
	local sub = Instance.new("TextLabel")
	sub.Size = UDim2.new(1, -16, 0, 20)
	sub.Position = UDim2.new(0, 8, 0, 34)
	sub.BackgroundTransparency = 1
	sub.Text = ort[2]
	sub.TextColor3 = Color3.fromRGB(170, 170, 180)
	sub.Font = Enum.Font.Gotham
	sub.TextSize = 13
	sub.TextXAlignment = Enum.TextXAlignment.Left
	sub.Parent = btn
	btn.MouseButton1Click:Connect(function()
		waehleSpawn:FireServer(i)
		gui:Destroy()
	end)
end
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBXMAP1"><Properties><string name="Name">KartenDaten</string><ProtectedString name="Source"><![CDATA[-- KartenDaten: Strassen und Haeuser (Stud-Koordinaten) fuer die Live-Karte im Handy.
