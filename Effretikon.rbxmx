---------------------------------------------------------------- Tankstelle SOCAR (-2000/200)
local function buildTankstelle(x, z)
	local y = heightAt(x, z)
	local folder = Instance.new("Folder")
	folder.Name = "Tankstelle-SOCAR"
	folder.Parent = workspace
	local y0 = y + 0.2
	mk(folder, Vector3.new(70, 0.3, 55), CFrame.new(x, y0 + 0.15, z), Color3.fromRGB(60, 60, 62), Enum.Material.Asphalt, "Vorplatz")
	for _, dx in ipairs({ -22, 22 }) do
		for _, dz in ipairs({ -14, 14 }) do
			mk(folder, Vector3.new(2, 16, 2), CFrame.new(x + dx, y0 + 8, z + dz), Color3.fromRGB(200, 200, 205), Enum.Material.Metal, "Saeule")
		end
	end
	mk(folder, Vector3.new(60, 1.6, 42), CFrame.new(x, y0 + 16.8, z), Color3.fromRGB(230, 230, 235), Enum.Material.SmoothPlastic, "Dach")
	mk(folder, Vector3.new(60, 1.2, 42), CFrame.new(x, y0 + 15.9, z), Color3.fromRGB(200, 30, 40), Enum.Material.SmoothPlastic, "Dachband")
	for _, dz in ipairs({ -8, 8 }) do
		local pumpe = mk(folder, Vector3.new(4, 8, 2.6), CFrame.new(x + dz, y0 + 4.2, z), Color3.fromRGB(235, 235, 240), Enum.Material.SmoothPlastic, "Zapfsaeule")
		mk(folder, Vector3.new(3.2, 2.2, 0.3), CFrame.new(x + dz, y0 + 6.4, z + 1.5), Color3.fromRGB(20, 20, 20), Enum.Material.SmoothPlastic, "Display")
		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = "Volltanken (CHF 2/L)"
		prompt.ObjectText = "SOCAR"
		prompt.HoldDuration = 1
		prompt.MaxActivationDistance = 12
		prompt.Parent = pumpe
		prompt.Triggered:Connect(function(player)
			local zuFuellen = {}
			for _, m in ipairs(workspace:GetDescendants()) do
				if m:IsA("Model") and m:GetAttribute("MofaTyp") then
					local pp = m.PrimaryPart or m:FindFirstChild("Seat")
					if pp and math.hypot(pp.Position.X - x, pp.Position.Z - z) < 45 then
						local tank = m:GetAttribute("Tank") or 0
						if tank < 3 then
							table.insert(zuFuellen, { m, tank })
						end
					end
				end
			end
			if #zuFuellen == 0 then
				popup(pumpe, "Kein Töffli zum Tanken in der Nähe.", Color3.fromRGB(255, 200, 90))
				return
			end
			local liter = 0
			for _, e in ipairs(zuFuellen) do
				liter += 3 - e[2]
			end
			local kosten = math.ceil(liter * 2)
			local ok, bezahlt = pcall(function()
				return geldFrage:Invoke(player, kosten)
			end)
			if ok and bezahlt then
				for _, e in ipairs(zuFuellen) do
					e[1]:SetAttribute("Tank", 3)
				end
				popup(pumpe, ("Getankt: %.1f L fuer CHF %d"):format(liter, kosten), Color3.fromRGB(120, 230, 140))
			else
				popup(pumpe, ("Nicht genug Geld (CHF %d)."):format(kosten), Color3.fromRGB(255, 90, 70))
			end
		end)
	end
	mk(folder, Vector3.new(1.6, 14, 1.6), CFrame.new(x, y0 + 7, z - 20), Color3.fromRGB(120, 120, 125), Enum.Material.Metal, "Schild-Mast")
	sign(folder, "SOCAR", CFrame.new(x, y0 + 22, z - 20.9), 26, 9, Color3.fromRGB(0, 60, 160), Color3.new(1, 1, 1))
end
buildTankstelle(-2000, 200)
print("[Effretikon] SOCAR-Tankstelle gebaut")

---------------------------------------------------------------- Auto-Bots und Postauto-Bus
-- Rechtsfahren mit Spuroffset, langsamer in Kurven, Raycast hlt vor Spielern,
-- Mofas und anderen Bots an. Keine Ampeln oder Vorfahrtsregeln.

local CAR_COLORS = {
	Color3.fromRGB(235, 235, 235), Color3.fromRGB(30, 30, 35), Color3.fromRGB(180, 30, 40),
	Color3.fromRGB(40, 70, 150), Color3.fromRGB(60, 110, 60), Color3.fromRGB(200, 170, 40),
}

local function isBlockedHit(result)
	local node = result.Instance
	while node and node ~= workspace do
		if node:IsA("Model") then
			if node:FindFirstChildWhichIsA("Humanoid", true) or node:GetAttribute("MofaTyp") or node.Name == "Auto" or node.Name == "Postauto" then
				return true
			end
		end
		node = node.Parent
	end
	return false
end

local function driveModel(model, main, waypoints, opts)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { model, workspace.Terrain }
	local idx = opts.startIndex
	local dir = 1
	local speed = 0
	local pause = 0
	local x0, z0 = waypoints[idx * 2 - 1], waypoints[idx * 2]
	main.CFrame = CFrame.new(x0, heightAt(x0, z0) + opts.rideHeight, z0)
	return function(dt)
		if not main.Parent then
			return
		end
		if pause > 0 then
			pause -= dt
			return
		end
		local n = #waypoints / 2
		local nxt = idx + dir
		if nxt < 1 or nxt > n then
			dir = -dir
			if opts.stopAtEnds then
				pause = opts.stopAtEnds
				return
			end
			nxt = idx + dir
		end
		local bx, bz = waypoints[nxt * 2 - 1], waypoints[nxt * 2]
		local segDx, segDz = bx - main.Position.X, bz - main.Position.Z
		local segLen = math.sqrt(segDx * segDx + segDz * segDz)
		if segLen < 0.05 then
			idx = nxt
			return
		end
		local ux, uz = segDx / segLen, segDz / segLen
		local targetSpeed = opts.speed
		local n2 = nxt + dir
		if n2 >= 1 and n2 <= n then
			local cx2, cz2 = waypoints[n2 * 2 - 1], waypoints[n2 * 2]
			local d2x, d2z = cx2 - bx, cz2 - bz
			local d2Len = math.sqrt(d2x * d2x + d2z * d2z)
			if d2Len > 0.01 and (ux * d2x + uz * d2z) / d2Len < 0.7 then
				targetSpeed = math.min(targetSpeed, 10)
			end
		end
		local look = main.CFrame.LookVector
		local flatLook = Vector3.new(look.X, 0, look.Z)
		if flatLook.Magnitude > 0.01 then
			local result = workspace:Raycast(main.Position + Vector3.new(0, 2, 0), flatLook.Unit * opts.lookAhead, params)
			if result and isBlockedHit(result) then
				targetSpeed = 0
			end
		end
		if targetSpeed > speed then
			speed = math.min(speed + opts.accel * dt, targetSpeed)
		else
			speed = math.max(speed - opts.brake * dt, targetSpeed)
		end
		local rx, rz = -uz, ux -- rechts der Fahrtrichtung
		local tx, tz = bx + rx * opts.laneOffset, bz + rz * opts.laneOffset
		local dx, dz = tx - main.Position.X, tz - main.Position.Z
		local dist = math.sqrt(dx * dx + dz * dz)
		if dist < 0.05 then
			idx = nxt
			return
		end
		local travel = math.min(speed * dt / dist, 1)
		local nx2 = main.Position.X + dx * travel
		local nz2 = main.Position.Z + dz * travel
		local y2 = heightAt(nx2, nz2) + opts.rideHeight
		local lookV = Vector3.new(dx, 0, dz)
		if lookV.Magnitude > 0.01 then
			main.CFrame = CFrame.new(Vector3.new(nx2, y2, nz2), Vector3.new(nx2, y2, nz2) + lookV.Unit)
		end
		if travel >= 1 then
			idx = nxt
		end
	end
end

local function buildCar(waypoints, startIndex, speed, color)
	local model = Instance.new("Model")
	model.Name = "Auto"
	local body = Instance.new("Part")
	body.Size = Vector3.new(6.5, 5.5, 15)
	body.Color = color
	body.Material = Enum.Material.SmoothPlastic
	body.TopSurface = Enum.SurfaceType.Smooth
	body.BottomSurface = Enum.SurfaceType.Smooth
	body.Parent = model
	local cabin = Instance.new("Part")
	cabin.Size = Vector3.new(5.6, 3.0, 7.5)
	cabin.Color = Color3.fromRGB(40, 60, 70)
	cabin.Material = Enum.Material.Glass
	cabin.Transparency = 0.25
	cabin.Parent = model
	local weld = Instance.new("WeldConstraint"); weld.Part0 = body; weld.Part1 = cabin; weld.Parent = cabin
	cabin.CFrame = body.CFrame * CFrame.new(0, 4.2, -0.5)
	for _, dz in ipairs({ -5, 5 }) do
		for _, dx in ipairs({ -3.6, 3.6 }) do
			local light = Instance.new("Part")
			light.Shape = Enum.PartType.Cylinder
			light.Size = Vector3.new(0.6, 1.4, 1.4)
			light.Color = dz < 0 and Color3.fromRGB(255, 255, 230) or Color3.fromRGB(200, 30, 30)
			light.Material = Enum.Material.Neon
			light.CanCollide = false
			light.Parent = model
			local w2 = Instance.new("WeldConstraint"); w2.Part0 = body; w2.Part1 = light; w2.Parent = light
			light.CFrame = body.CFrame * CFrame.new(dx, -0.5, dz * 7.4) * CFrame.Angles(0, 0, math.rad(90))
		end
	end
	model.PrimaryPart = body
	model.Parent = workspace
	local step = driveModel(model, body, waypoints, {
		startIndex = startIndex,
		speed = speed,
		accel = 14,
		brake = 26,
		laneOffset = 5.5,
		rideHeight = 3,
		lookAhead = 30,
	})
	RunService.Heartbeat:Connect(step)
end

local function cloneRoute(r)
	local c = {}
	for i = 1, #r do c[i] = r[i] end
	return c
end

for i, route in ipairs(ROUTES) do
	if #route >= 4 then
		local n = #route / 2
		buildCar(cloneRoute(route), math.max(1, math.floor(n * 0.25)), 22 + (i % 3) * 5, CAR_COLORS[((i - 1) % #CAR_COLORS) + 1])
		if #route >= 8 then
			buildCar(cloneRoute(route), math.max(1, math.floor(n * 0.7)), 20 + (i % 3) * 5, CAR_COLORS[(i % #CAR_COLORS) + 1])
		end
	end
end
print("[Effretikon] Auto-Bots unterwegs:", #ROUTES)

