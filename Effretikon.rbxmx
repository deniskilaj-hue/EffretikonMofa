local BUS_ROUTE = { 0, 30, 90, 240, 185, 443, 207.1, 456.9, 233.2, 469.9, 245.6, 474.1, 269.3, 477.2, 282.6, 477.5, 531.1, 455, 586, 458.6, 624.1, 468.7, 642, 475.9, 676.2, 494, 705.8, 515.8, 729.9, 539.6, 749.8, 566.2, 1002.8, 951.5, 1050.4, 1034.8, 1245.8, 1398.6, 1264, 1426.7, 1287, 1456.1, 1312.2, 1480.7, 1450, 1586.2, 1476.6, 1611.4, 1488.5, 1626.4, 1502.1, 1646.5, 1486.9, 1623.9, 1520.7, 1691.7, 1526, 1716.4, 1530, 1758.6, 1528.9, 1836.5, 1524.7, 1914.7, 1520.7, 1944.6, 1510.2, 1998.4, 1499.8, 2052.2, 1495.5, 2118.7, 1496.5, 2154.6, 1505.6, 2222, 1514.3, 2289.4, 1523.1, 2356.7, 1531.8, 2424.1, 1540.2, 2494, 1548.6, 2564, 1557, 2633.9, 1570.7, 2719.3, 1581.2, 2765.4, 1591.5, 2811.6, 1609.1, 2873.7, 1631.4, 2938.2, 1653.6, 3002.8, 1684.5, 3083.1, 1715.3, 3163.3, 1746.1, 3243.6, 1776.9, 3323.9, 1807.6, 3404.2, 1838.4, 3484.4, 1869.2, 3564.7, 1900, 3645, 1930.7, 3725.3, 1961.5, 3805.5, 1992.3, 3885.8, 2023.1, 3966.1, 2053.9, 4046.4, 2084.6, 4126.6, 2114, 4202.5, 2143.3, 4278.3, 2145.6, 4296.1, 2165, 4335.6, 2145.5, 4290.3, 2144.6, 4342.8, 2151.2, 4354, 2176.9, 4376.8, 2162.9, 4330.2, 2187.3, 4392.5, 2216.9, 4471.1, 2241.1, 4534.5, 2265.3, 4597.9, 2289.5, 4661.3, 2308.5, 4708.7, 2336.8, 4763.4, 2364.9, 4818.1, 2367.8, 4847.1, 2361, 4866.8, 2450, 4960, 2560, 5070, 2680, 5200, 2790, 5300, 2846, 5367 }
local function buildBus(route)
	local model = Instance.new("Model")
	model.Name = "Postauto"
	local body = Instance.new("Part")
	body.Size = Vector3.new(11, 10, 30)
	body.Color = Color3.fromRGB(255, 205, 0)
	body.Material = Enum.Material.SmoothPlastic
	body.Parent = model
	local roof = Instance.new("Part")
	roof.Size = Vector3.new(11.4, 0.6, 30.4)
	roof.Color = Color3.fromRGB(245, 245, 240)
	roof.CanCollide = false
	roof.Parent = model
	local w0 = Instance.new("WeldConstraint"); w0.Part0 = body; w0.Part1 = roof; w0.Parent = roof
	roof.CFrame = body.CFrame * CFrame.new(0, 5.3, 0)
	local windows = Instance.new("Part")
	windows.Size = Vector3.new(11.6, 3.2, 26)
	windows.Color = Color3.fromRGB(50, 65, 80)
	windows.Material = Enum.Material.Glass
	windows.Transparency = 0.3
	windows.CanCollide = false
	windows.Parent = model
	local w1 = Instance.new("WeldConstraint"); w1.Part0 = body; w1.Part1 = windows; w1.Parent = windows
	windows.CFrame = body.CFrame * CFrame.new(0, 2.2, 0)
	for _, dz in ipairs({ -10, 10 }) do
		for _, dx in ipairs({ -5.2, 5.2 }) do
			local wheel = Instance.new("Part")
			wheel.Shape = Enum.PartType.Cylinder
			wheel.Size = Vector3.new(1.6, 2.4, 2.4)
			wheel.Color = Color3.fromRGB(25, 25, 25)
			wheel.CanCollide = false
			wheel.Parent = model
			local w2 = Instance.new("WeldConstraint"); w2.Part0 = body; w2.Part1 = wheel; w2.Parent = wheel
			wheel.CFrame = body.CFrame * CFrame.new(dx, -4.2, dz) * CFrame.Angles(0, 0, math.rad(90))
		end
	end
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(400, 60)
	gui.Parent = body
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.fromScale(1, 1)
	lbl.BackgroundTransparency = 1
	lbl.Text = "POSTAUTO 620  Effretikon - Bisikon"
	lbl.TextColor3 = Color3.fromRGB(30, 30, 30)
	lbl.Font = Enum.Font.GothamBlack
	lbl.TextScaled = true
	lbl.Parent = gui
	model.PrimaryPart = body
	model.Parent = workspace
	local step = driveModel(model, body, route, {
		startIndex = 1,
		speed = 26,
		accel = 8,
		brake = 18,
		laneOffset = 5,
		rideHeight = 6.5,
		lookAhead = 42,
		stopAtEnds = 12,
	})
	RunService.Heartbeat:Connect(step)
end

buildBus(BUS_ROUTE)

---------------------------------------------------------------- Kantonspolizei Zuerich (2 Streifenwagen)
local function buildPolice(route, startIndex)
	local model = Instance.new("Model")
	model.Name = "Polizeiauto"
	local body = Instance.new("Part")
	body.Size = Vector3.new(6.5, 5.5, 15)
	body.Color = Color3.fromRGB(240, 240, 242)
	body.Material = Enum.Material.SmoothPlastic
	body.Parent = model
	local cabin = Instance.new("Part")
	cabin.Size = Vector3.new(5.6, 3.0, 7.5)
	cabin.Color = Color3.fromRGB(40, 60, 70)
	cabin.Material = Enum.Material.Glass
	cabin.Transparency = 0.25
	cabin.Parent = model
	local w0 = Instance.new("WeldConstraint"); w0.Part0 = body; w0.Part1 = cabin; w0.Parent = cabin
	cabin.CFrame = body.CFrame * CFrame.new(0, 4.2, -0.5)
	for _, dx in ipairs({ -3.3, 3.3 }) do
		local band = Instance.new("Part")
		band.Size = Vector3.new(0.2, 2.2, 13)
		band.Color = Color3.fromRGB(0, 70, 140)
		band.Material = Enum.Material.SmoothPlastic
		band.CanCollide = false
		band.Parent = model
		local w1 = Instance.new("WeldConstraint"); w1.Part0 = body; w1.Part1 = band; w1.Parent = band
		band.CFrame = body.CFrame * CFrame.new(dx, -0.4, 0)
		local gui = Instance.new("SurfaceGui")
		gui.Face = dx < 0 and Enum.NormalId.Left or Enum.NormalId.Right
		gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		gui.CanvasSize = Vector2.new(260, 44)
		gui.Parent = band
		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.fromScale(1, 1)
		lbl.BackgroundTransparency = 1
		lbl.Text = "KANTONSPOLIZEI  ZÜRICH"
		lbl.TextColor3 = Color3.new(1, 1, 1)
		lbl.Font = Enum.Font.GothamBlack
		lbl.TextScaled = true
		lbl.Parent = gui
	end
	local blau = Instance.new("Part")
	blau.Size = Vector3.new(2, 1, 1.6)
	blau.Color = Color3.fromRGB(0, 80, 255)
	blau.Material = Enum.Material.Neon
	blau.CanCollide = false
	blau.Parent = model
	local w2 = Instance.new("WeldConstraint"); w2.Part0 = body; w2.Part1 = blau; w2.Parent = blau
	blau.CFrame = body.CFrame * CFrame.new(0, 6.1, 0.9)
	local rot = Instance.new("Part")
	rot.Size = Vector3.new(2, 1, 1.6)
	rot.Color = Color3.fromRGB(255, 40, 40)
	rot.Material = Enum.Material.Neon
	rot.CanCollide = false
	rot.Parent = model
	local w3 = Instance.new("WeldConstraint"); w3.Part0 = body; w3.Part1 = rot; w3.Parent = rot
	rot.CFrame = body.CFrame * CFrame.new(0, 6.1, -0.9)
	local spot = Instance.new("SpotLight")
	spot.Color = Color3.fromRGB(60, 120, 255)
	spot.Range = 60
	spot.Brightness = 4
	spot.Parent = blau
	local blink = 0
	RunService.Heartbeat:Connect(function(dt)
		if not body.Parent then
			return
		end
		blink += dt
		local an = math.floor(blink / 0.25) % 2 == 0
		blau.Transparency = an and 0 or 0.7
		rot.Transparency = an and 0.7 or 0
		spot.Enabled = an
	end)
	model.PrimaryPart = body
	model.Parent = workspace
	local step = driveModel(model, body, route, {
		startIndex = startIndex,
		speed = 30,
		accel = 16,
		brake = 30,
		laneOffset = 5.5,
		rideHeight = 3,
		lookAhead = 34,
	})
	RunService.Heartbeat:Connect(step)
end
buildPolice(cloneRoute(ROUTES[1]), 1)
buildPolice(cloneRoute(ROUTES[3]), math.max(1, math.floor(#ROUTES[3] / 4)))
print("[Effretikon] 2 Kantonspolizei-Streifenwagen unterwegs")
print("[Effretikon] Postauto 620 unterwegs: Effretikon - Bisikon")

print("[Effretikon] Fertig. Viel Spass!")
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX10332"><Properties><string name="Name">TuningData</string><ProtectedString name="Source"><![CDATA[-- TuningData: Ciao-Tuningteile und die Formel, wie sie Tempo, Beschleunigung und Lautstaerke veraendern.
-- Namen und Teile sind an echte Töffli-Tuningteile angelehnt (z.B. wie sie bei mofakult.de zu finden sind),
-- die Werte sind aber mein eigenes Spielbalancing und keine echten Messwerte.

local TuningData = {}

TuningData.PARTS = {
	vergaser = {
		{ id = "sha1212", name = "Dell'Orto SHA 12/12 (Serie)", price = 0, speed = 0, accel = 0, sound = 0, stock = true },
		{ id = "sha1313", name = "Dell'Orto SHA 13/13", price = 95, speed = 4, accel = 2, sound = 1 },
		{ id = "phbg19", name = "Dell'Orto PHBG 19mm", price = 180, speed = 8, accel = 3, sound = 1 },
		{ id = "phbg21", name = "Dell'Orto PHBG 21mm", price = 260, speed = 12, accel = 4, sound = 2 },
		{ id = "polini19", name = "Polini CP 19mm", price = 320, speed = 14, accel = 5, sound = 2 },
	},
	zylinder = {
		{ id = "serie38", name = "Original 38mm / 50ccm", price = 0, speed = 0, accel = 0, sound = 0, stock = true },
		{ id = "dr384", name = "DR 38.4mm / 50ccm Sport", price = 150, speed = 5, accel = 2, sound = 1 },
		{ id = "polini43", name = "Polini 43mm / 63ccm", price = 430, speed = 16, accel = 6, sound = 2 },
		{ id = "malossi43", name = "Malossi 43mm / 65ccm", price = 460, speed = 18, accel = 7, sound = 3 },
		{ id = "pinasco46", name = "Pinasco 46mm / 70ccm", price = 590, speed = 24, accel = 9, sound = 3 },
	},
	luftfilter = {
		{ id = "serie_filter", name = "Original Airbox", price = 0, speed = 0, accel = 0, sound = 0, stock = true },
		{ id = "malossi_filter", name = "Malossi Sportfilter", price = 35, speed = 2, accel = 2, sound = 1 },
		{ id = "polini_filter", name = "Polini offener Filter", price = 55, speed = 4, accel = 3, sound = 2 },
	},
	auspuff = {
		{ id = "serie_auspuff", name = "Original Auspuff", price = 0, speed = 0, accel = 0, sound = 0, stock = true },
		{ id = "sito20", name = "SITO Ø20mm", price = 140, speed = 6, accel = 2, sound = 3 },
		{ id = "giannelli", name = "Giannelli Fire", price = 210, speed = 10, accel = 3, sound = 4 },
		{ id = "simonini", name = "Simonini Racing", price = 340, speed = 14, accel = 4, sound = 5 },
	},
}

TuningData.CATEGORY_ORDER = { "vergaser", "zylinder", "luftfilter", "auspuff" }
TuningData.CATEGORY_LABEL = { vergaser = "Vergaser", zylinder = "Zylinder", luftfilter = "Luftfilter", auspuff = "Auspuff" }

function TuningData.find(category, id)
	for _, p in ipairs(TuningData.PARTS[category] or {}) do
		if p.id == id then
			return p
		end
	end
	return nil
end

function TuningData.stockPart(category)
	for _, p in ipairs(TuningData.PARTS[category]) do
		if p.stock then
			return p
		end
	end
	return TuningData.PARTS[category][1]
end

-- installed: { vergaser = "phbg19", zylinder = "polini43", ... } (fehlende = Serie)
-- base: { maxSpeed, accel, brake, turn } vom Mofa-Typ (Ciao/SI/Maxi)
function TuningData.calc(base, installed)
	local addSpeed, addAccel, soundScore = 0, 0, 0
	for _, cat in ipairs(TuningData.CATEGORY_ORDER) do
		local id = installed and installed[cat]
		local part = (id and TuningData.find(cat, id)) or TuningData.stockPart(cat)
		addSpeed += part.speed
		addAccel += part.accel
		soundScore += part.sound
	end
	return {
		maxSpeed = base.maxSpeed + addSpeed,
		accel = base.accel + addAccel * 0.6,
		brake = base.brake,
		turn = base.turn,
		soundScore = soundScore, -- 0 (Serie) bis ca. 20 (Vollausbau)
	}
end

return TuningData
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="RBX10333"><Properties><string name="Name">TuningSystem</string></Properties><Item class="ModuleScript" referent="RBX10334"><Properties><string name="Name">TuningData</string><ProtectedString name="Source"><![CDATA[-- TuningData: Ciao-Tuningteile und die Formel, wie sie Tempo, Beschleunigung und Lautstaerke veraendern.
