	pickup.ObjectText = "Dönerladen"
	pickup.HoldDuration = 0.5
	pickup.MaxActivationDistance = 12
	pickup.Parent = offen
	pickup.Triggered:Connect(function(player)
		local ok = giveCarryTool(player, "Döner", Vector3.new(2.6, 1.4, 1.4), Color3.fromRGB(222, 184, 135), function(tool, handle)
			local fleischStk = Instance.new("Part")
			fleischStk.Size = Vector3.new(1.6, 1, 1.2)
			fleischStk.Color = Color3.fromRGB(150, 80, 45)
			fleischStk.CanCollide = false
			fleischStk.Parent = tool
			local w = Instance.new("WeldConstraint")
			w.Part0 = handle
			w.Part1 = fleischStk
			w.Parent = fleischStk
			fleischStk.CFrame = handle.CFrame * CFrame.new(0, 0.3, 0)
		end)
		if ok then
			popup(offen, "Bring den Döner zum Töfflitreffen nach Bisikon!", Color3.fromRGB(120, 230, 140))
		else
			popup(offen, "Du hast schon einen Döner.", Color3.fromRGB(255, 200, 90))
		end
	end)
end

local function buildFabrik(x, z)
	local y = heightAt(x, z)
	local folder = Instance.new("Folder")
	folder.Name = "Mofakult-Fabrik"
	folder.Parent = workspace
	local W, D, H = 90, 55, 26
	local wallC = Color3.fromRGB(155, 160, 170)
	local y0 = y + 0.2
	mk(folder, Vector3.new(W, 0.4, D), CFrame.new(x, y0 + 0.2, z), Color3.fromRGB(120, 120, 120), Enum.Material.Concrete, "Boden")
	mk(folder, Vector3.new(W, H, 1.5), CFrame.new(x, y0 + H / 2, z - D / 2), wallC, Enum.Material.Concrete, "Wand-Nord")
	mk(folder, Vector3.new(W, H, 1.5), CFrame.new(x, y0 + H / 2, z + D / 2), wallC, Enum.Material.Concrete, "Wand-Sued")
	mk(folder, Vector3.new(1.5, H, D), CFrame.new(x + W / 2, y0 + H / 2, z), wallC, Enum.Material.Concrete, "Wand-Ost")
	-- Westfront mit grossem Tor (offen)
	mk(folder, Vector3.new(1.5, H, 12), CFrame.new(x - W / 2, y0 + H / 2, z - 21.5), wallC, Enum.Material.Concrete, "Front")
	mk(folder, Vector3.new(1.5, H, 12), CFrame.new(x - W / 2, y0 + H / 2, z + 21.5), wallC, Enum.Material.Concrete, "Front")
	mk(folder, Vector3.new(1.5, 6, 31), CFrame.new(x - W / 2, y0 + 23, z), wallC, Enum.Material.Concrete, "Torsturz")
	mk(folder, Vector3.new(W + 2, 1.2, D + 2), CFrame.new(x, y0 + H + 0.6, z), Color3.fromRGB(70, 75, 85), Enum.Material.Metal, "Dach")
	mk(folder, Vector3.new(5, 20, 5), CFrame.new(x + W / 2 - 8, y0 + H + 10, z - D / 2 + 8), Color3.fromRGB(120, 70, 60), Enum.Material.Brick, "Kamin")
	-- Torso: Paletten mit Kisten vor dem Tor
	for i = 0, 2 do
		mk(folder, Vector3.new(8, 1, 8), CFrame.new(x - W / 2 - 12, y0 + 0.5 + i * 3.2, z - 14 + i * 12), Color3.fromRGB(160, 120, 70), Enum.Material.Wood, "Palette")
		mk(folder, Vector3.new(6, 2.6, 6), CFrame.new(x - W / 2 - 12, y0 + 2.3 + i * 3.2, z - 14 + i * 12), Color3.fromRGB(180, 140, 80), Enum.Material.Wood, "Kiste")
	end
	-- Mofakult-Shop am Tresen: alle Teile kaufen wie im Handy
	local tresen = mk(folder, Vector3.new(14, 3.2, 2.5), CFrame.new(x - W / 2 - 6, y0 + 1.6, z - D / 2 + 6), Color3.fromRGB(60, 60, 66), Enum.Material.SmoothPlastic, "Shop-Tresen")
	sign(folder, "SHOP", CFrame.new(x - W / 2 - 6, y0 + 5.5, z - D / 2 + 6) * CFrame.Angles(0, math.pi / 2, 0), 12, 4, Color3.fromRGB(255, 120, 30), Color3.new(1, 1, 1))
	local shopPrompt = Instance.new("ProximityPrompt")
	shopPrompt.ActionText = "Tuning-Shop \u{00F6}ffnen"
	shopPrompt.ObjectText = "Mofakult-Shop"
	shopPrompt.HoldDuration = 0.5
	shopPrompt.MaxActivationDistance = 14
	shopPrompt.Parent = tresen
	shopPrompt.Triggered:Connect(function(player)
		shopOeffnen:Fire(player)
	end)

	sign(folder, "MOFAKULT", CFrame.new(x, y0 + H + 6, z - D / 2 - 0.8), 50, 10, Color3.fromRGB(20, 20, 20), Color3.fromRGB(255, 120, 30))
	local kistenPrompt = Instance.new("ProximityPrompt")
	kistenPrompt.ActionText = "Teilekiste nehmen"
	kistenPrompt.ObjectText = "Mofakult-Versand"
	kistenPrompt.HoldDuration = 0.5
	kistenPrompt.MaxActivationDistance = 14
	kistenPrompt.Parent = mk(folder, Vector3.new(6, 0.4, 6), CFrame.new(x - W / 2 - 12, y0 + 0.4, z + 6), Color3.fromRGB(255, 120, 30), Enum.Material.Neon, "Abholpunkt")
	kistenPrompt.Triggered:Connect(function(player)
		local ok = giveCarryTool(player, "Teilekiste", Vector3.new(3, 2.6, 3), Color3.fromRGB(180, 140, 80), function(tool, handle)
			local gui = Instance.new("SurfaceGui")
			gui.Face = Enum.NormalId.Top
			gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
			gui.CanvasSize = Vector2.new(120, 120)
			gui.Parent = handle
			local lbl = Instance.new("TextLabel")
			lbl.Size = UDim2.fromScale(1, 1)
			lbl.BackgroundTransparency = 1
			lbl.Text = "MOFAKULT"
			lbl.TextColor3 = Color3.fromRGB(255, 120, 30)
			lbl.Font = Enum.Font.GothamBlack
			lbl.TextScaled = true
			lbl.Parent = gui
		end)
		if ok then
			popup(kistenPrompt.Parent, "Bring die Kiste zur Ciao-Garage in Bisikon!", Color3.fromRGB(120, 230, 140))
		else
			popup(kistenPrompt.Parent, "Du hast schon eine Kiste.", Color3.fromRGB(255, 200, 90))
		end
	end)
end

