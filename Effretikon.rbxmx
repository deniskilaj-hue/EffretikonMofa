	local offen = sign(folder, "OFFEN", CFrame.new(x - W / 2 - 0.8, y0 + 9, z - 8) * CFrame.Angles(0, math.pi / 2, 0), 10, 4, Color3.fromRGB(40, 160, 60), Color3.new(1, 1, 1))
