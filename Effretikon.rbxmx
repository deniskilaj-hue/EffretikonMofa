<R12>0.0000</R12><R20>0.7071</R20><R21>0.0000</R21><R22>-0.7071</R22></CoordinateFrame><Vector3 name="size"><X>21.43</X><Y>1.2</Y><Z>14.28</Z></Vector3><Color3uint8 name="Color3uint8">4293312040</Color3uint8><token name="Material">272</token></Properties></Item></Item><Item class="SpawnLocation" referent="RBX10324"><Properties><string name="Name">SpawnLocation</string><bool name="Anchored">true</bool><CoordinateFrame name="CFrame"><X>0</X><Y>0.6</Y><Z>20</Z><R00>1.0000</R00><R01>0.0000</R01><R02>0.0000</R02><R10>0.0000</R10><R11>1.0000</R11><R12>0.0000</R12><R20>0.0000</R20><R21>0.0000</R21><R22>1.0000</R22></CoordinateFrame><Vector3 name="size"><X>12</X><Y>1</Y><Z>12</Z></Vector3><Color3uint8 name="Color3uint8">4293322470</Color3uint8><token name="Material">256</token><bool name="Neutral">true</bool><int name="Duration">0</int><float name="Transparency">1</float><bool name="CanCollide">false</bool></Properties></Item><Item class="Script" referent="RBX10331"><Properties><string name="Name">Welt</string><ProtectedString name="Source"><![CDATA[-- Welt: baut beim Spielstart das Gelaende (echte Hoehen), den Wald, den Effimaert
-- zum Reinlaufen, Schilder und die fahrbaren Mofas. Dauert beim Start ca. 20-60 Sekunden.
-- 1 Meter = 3.571 Studs, 1 Stud pro Sekunde ist ungefaehr 1 km/h.

local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")
local daten = script:FindFirstChild("Daten") or script.Parent:WaitForChild("Daten")

---------------------------------------------------------------- Server-Kommunikation (frueh, damit TuningServer sie findet)
local jobGeld = Instance.new("BindableEvent")
jobGeld.Name = "JobGeld"
jobGeld.Parent = ServerStorage

-- GeldFrage: zieht Geld ab und meldet zurueck, ob es gereicht hat (implementiert im TuningServer)
local geldFrage = Instance.new("BindableFunction")
geldFrage.Name = "GeldFrage"
geldFrage.Parent = ServerStorage

local mofaSpawner = Instance.new("BindableFunction")
mofaSpawner.Name = "MofaSpawner"
mofaSpawner.Parent = ServerStorage

-- ShopOeffnen: Mofakult-Shop am Tresen oeffnet das Handy im Shop-Reiter (TuningServer feuert OeffneShop)
local shopOeffnen = Instance.new("BindableEvent")
shopOeffnen.Name = "ShopOeffnen"
shopOeffnen.Parent = ServerStorage
local spawnMofaFunc
local spawnQueue = {}
mofaSpawner.OnInvoke = function(player, typ)
	if spawnMofaFunc then
		return spawnMofaFunc(player, typ)
	end
	table.insert(spawnQueue, { player, typ })
	return "Einen Moment, die Welt baut sich noch auf."
end

local GX0, GZ0, STEP, COLS, ROWS = -1914.945, -1903.647, 42.8520, 192, 226
local HS_MIN, HS_STEP = -25.40589, 0.0400875

local B64 = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local DEC = {}
for i = 1, #B64 do
	DEC[string.byte(B64, i)] = i - 1
end

local function joinModules(prefix, n)
	local list = {}
	for i = 1, n do
		list[i] = require(daten[prefix .. i])
	end
	return table.concat(list)
end
local HDATA = joinModules("H", 3)
local MDATA = joinModules("M", 2)

local function cellHeight(i, j)
	local k = (j * COLS + i) * 2
	return (DEC[string.byte(HDATA, k + 1)] * 64 + DEC[string.byte(HDATA, k + 2)]) * HS_STEP + HS_MIN
end

local function heightAt(x, z)
	local fx = math.clamp((x - GX0) / STEP, 0, COLS - 1.001)
	local fz = math.clamp((z - GZ0) / STEP, 0, ROWS - 1.001)
	local i, j = math.floor(fx), math.floor(fz)
	local tx, tz = fx - i, fz - j
	local a = cellHeight(i, j) * (1 - tx) + cellHeight(i + 1, j) * tx
	local b = cellHeight(i, j + 1) * (1 - tx) + cellHeight(i + 1, j + 1) * tx
	return a * (1 - tz) + b * tz
end

local function maskAt(i, j)
	return string.byte(MDATA, j * COLS + i + 1) - 48 -- 0 Wiese, 1 Wald, 2 Reben
end

