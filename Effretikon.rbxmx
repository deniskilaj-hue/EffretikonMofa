---------------------------------------------------------------- Gelaende
local terrain = workspace.Terrain
local RES = 4

local function fillRect(xa, xb, za, zb)
	local CH = 32
	local chunkCount = 0
	local xs = xa
	while xs < xb do
		local xe = math.min(xs + CH * RES, xb)
		local zs = za
		while zs < zb do
			local ze = math.min(zs + CH * RES, zb)
			local nx, nz = (xe - xs) / RES, (ze - zs) / RES
			local hts = {}
			local lo, hi = math.huge, -math.huge
			for ix = 1, nx do
				hts[ix] = {}
				for iz = 1, nz do
					local h = heightAt(xs + (ix - 0.5) * RES, zs + (iz - 0.5) * RES)
					hts[ix][iz] = h
					if h < lo then lo = h end
					if h > hi then hi = h end
				end
			end
			local y0 = math.floor((lo - 60) / RES) * RES -- weit nach unten, damit nirgends eine Kante sichtbar wird
			local y1 = math.ceil(hi / RES) * RES + RES
			local ny = (y1 - y0) / RES
			local mats, occ = {}, {}
			for ix = 1, nx do
				mats[ix], occ[ix] = {}, {}
				for iy = 1, ny do
					mats[ix][iy], occ[ix][iy] = {}, {}
				end
			end
			for ix = 1, nx do
				for iz = 1, nz do
					local h = hts[ix][iz]
					local wx, wz = xs + (ix - 0.5) * RES, zs + (iz - 0.5) * RES
					local ci = math.clamp(math.floor((wx - GX0) / STEP + 0.5), 0, COLS - 1)
					local cj = math.clamp(math.floor((wz - GZ0) / STEP + 0.5), 0, ROWS - 1)
					local m = maskAt(ci, cj)
					local mat = Enum.Material.Grass
					if m == 1 then
						mat = Enum.Material.LeafyGrass
					elseif m == 2 then
						mat = Enum.Material.Ground
					end
					for iy = 1, ny do
						local yb = y0 + (iy - 1) * RES
						local o = math.clamp((h - yb) / RES, 0, 1)
						if o > 0 and yb >= h - 60 then
							mats[ix][iy][iz] = mat
							occ[ix][iy][iz] = o
						else
							mats[ix][iy][iz] = Enum.Material.Air
							occ[ix][iy][iz] = 0
						end
					end
				end
			end
			terrain:WriteVoxels(Region3.new(Vector3.new(xs, y0, zs), Vector3.new(xe, y1, ze)), RES, mats, occ)
			chunkCount = chunkCount + 1
			if chunkCount % 3 == 0 then
				task.wait()
			end
			zs = ze
		end
		xs = xe
	end
end

print("[Effretikon] Gelaende wird gebaut ...")
for _, r in ipairs(RECTS) do
	fillRect(r[1], r[2], r[3], r[4])
end
print("[Effretikon] Gelaende fertig")
startPlatform:Destroy()

---------------------------------------------------------------- Fensterbaender an grossen Haeusern
do
	local gebaeudeFolders = {}
	for _, f in ipairs(workspace:GetDescendants()) do
		if f:IsA("Folder") and (f.Name == "Gebaeude" or f.Name == "Bisikon") then
			table.insert(gebaeudeFolders, f)
		end
	end
	local glassC = Color3.fromRGB(45, 55, 65)
	local bandCount = 0
	for _, f in ipairs(gebaeudeFolders) do
		for _, p in ipairs(f:GetChildren()) do
			if p:IsA("Part") and not string.find(p.Name, "-Dach") and p.Size.Y >= 26 and math.min(p.Size.X, p.Size.Z) >= 30 then
				local floors = math.min(math.floor((p.Size.Y - 6) / 11), 4)
				for fl = 0, floors - 1 do
					local ly = 9 + fl * 11 - p.Size.Y / 2
					for _, side in ipairs({ "x+", "x-", "z+", "z-" }) do
						local band = Instance.new("Part")
						if side == "x+" or side == "x-" then
							band.Size = Vector3.new(0.3, 5, p.Size.Z - 8)
							band.CFrame = p.CFrame * CFrame.new((side == "x+" and 1 or -1) * (p.Size.X / 2 + 0.15), ly, 0)
						else
							band.Size = Vector3.new(p.Size.X - 8, 5, 0.3)
							band.CFrame = p.CFrame * CFrame.new(0, ly, (side == "z+" and 1 or -1) * (p.Size.Z / 2 + 0.15))
						end
						band.Anchored = true
						band.Color = glassC
						band.Material = Enum.Material.Glass
						band.Transparency = 0.35
						band.CanCollide = false
						band.Name = "Fensterband"
						band.Parent = f
						bandCount += 1
						if bandCount % 300 == 0 then
							task.wait()
						end
					end
				end
			end
		end
	end
	print("[Effretikon] Fensterbaender:", bandCount)
end

---------------------------------------------------------------- Baeume
local treeFolder = Instance.new("Folder")
treeFolder.Name = "Baeume"
treeFolder.Parent = workspace

-- Freihalten: Doenerladen, Mofakult-Fabrik, Treffplatz und Garage
local BAUM_FREI = { { 500, 0, 70 }, { -1000, 2000, 130 }, { 2846, 5367, 70 }, { 2800, 5321, 70 } }

local rng = Random.new(2026)
local made = 0
local function plantTree(x, z, s)
	for _, b in ipairs(BAUM_FREI) do
		if math.hypot(x - b[1], z - b[2]) < b[3] then
			return
		end
	end
	local y = heightAt(x, z)
	local trunkH = 20 + 10 * s
	local crown = 20 + 12 * s
	local trunk = Instance.new("Part")
	trunk.Anchored = true
	trunk.Size = Vector3.new(1.6, trunkH, 1.6)
	trunk.CFrame = CFrame.new(x, y + trunkH / 2 - 1, z)
	trunk.Color = Color3.fromRGB(95, 70, 50)
	trunk.Material = Enum.Material.Wood
	trunk.Parent = treeFolder
	local leaves = Instance.new("Part")
	leaves.Anchored = true
	leaves.Shape = Enum.PartType.Ball
	leaves.Size = Vector3.new(crown, crown * 1.15, crown)
	leaves.CFrame = CFrame.new(x, y + trunkH + crown * 0.35, z)
	leaves.Color = Color3.fromRGB(50 + rng:NextInteger(0, 25), 100 + rng:NextInteger(0, 35), 45 + rng:NextInteger(0, 15))
	leaves.Material = Enum.Material.Grass
	leaves.CanCollide = false
	leaves.CastShadow = false
	leaves.Parent = treeFolder
	made = made + 1
	if made % 400 == 0 then
		task.wait()
	end
end

-- Einzelne Baeume (Gaerten, Strassenrand, Bisikon)
for i = 1, #TREES, 3 do
	plantTree(TREES[i], TREES[i + 1], TREES[i + 2])
end

-- Wald nach OpenStreetMap-Flaechen
for _, r in ipairs(RECTS) do
	local ci0 = math.max(math.floor((r[1] - GX0) / STEP), 0)
	local ci1 = math.min(math.ceil((r[2] - GX0) / STEP), COLS - 2)
	local cj0 = math.max(math.floor((r[3] - GZ0) / STEP), 0)
	local cj1 = math.min(math.ceil((r[4] - GZ0) / STEP), ROWS - 2)
	for cj = cj0, cj1 do
		for ci = ci0, ci1 do
			if maskAt(ci, cj) == 1 and rng:NextNumber() < 0.55 then
				local x = GX0 + (ci + rng:NextNumber() - 0.5) * STEP
				local z = GZ0 + (cj + rng:NextNumber() - 0.5) * STEP
				plantTree(x, z, rng:NextNumber())
			end
		end
	end
end
print("[Effretikon] Baeume gepflanzt:", made)

---------------------------------------------------------------- Zusatz-Wald bei 3000/4000 (reicht bis zu den Haeusern)
local WALD_ZONEN = {
	{ 2950, 3560, 3950, 4560 },
	{ 2650, 2950, 3650, 3950 },
	{ 2350, 2650, 3400, 3650 },
}
do
	local hindernisse = {}
	for _, f in ipairs(workspace:GetDescendants()) do
		if f:IsA("Folder") then
			local r = 0
			if f.Name == "Strassen" then
				r = 16
			elseif f.Name == "Gebaeude" or f.Name == "Bisikon" then
				r = 30
			elseif f.Name == "Gewaesser" or f.Name == "Bahn" then
				r = 12
			end
			if r > 0 then
				for _, p in ipairs(f:GetChildren()) do
					if p:IsA("Part") then
						table.insert(hindernisse, { p.Position.X, p.Position.Z, r })
					end
				end
			end
		end
	end
	local rngW = Random.new(77)
	local count = 0
	for _, zone in ipairs(WALD_ZONEN) do
		local x = zone[1]
		while x < zone[2] do
			local z = zone[3]
			while z < zone[4] do
				local px, pz = x + rngW:NextNumber(-5, 5), z + rngW:NextNumber(-5, 5)
				local ok = true
				for _, h in ipairs(hindernisse) do
					if math.hypot(h[1] - px, h[2] - pz) < h[3] then
						ok = false
						break
					end
				end
				if ok and rngW:NextNumber() < 0.6 then
					plantTree(px, pz, rngW:NextNumber())
					count += 1
				end
				z += 14
			end
			x += 14
			if count % 300 == 0 then
				task.wait()
			end
		end
	end
	print("[Effretikon] Zusatz-Wald gepflanzt:", count)
end

---------------------------------------------------------------- Schilder
