}]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX10336"><Properties><string name="Name">TuningServer</string><ProtectedString name="Source"><![CDATA[-- TuningServer: Shop-Kaeufe, Inventar pro Spieler, Teile einbauen, Handy an jeden Spieler verteilen.
-- Das Inventar wird nur im Arbeitsspeicher gehalten (kein DataStore) und ist nach einem Rejoin wieder leer.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TuningData = require(script.Parent:WaitForChild("TuningData"))

local remotes = Instance.new("Folder")
remotes.Name = "TuningRemotes"
remotes.Parent = ReplicatedStorage

-- Kartendaten fuer die Live-Karte im Handy einmalig nach ReplicatedStorage
local kartenDaten = script.Parent:WaitForChild("KartenDaten")
kartenDaten.Parent = ReplicatedStorage
local buyEvent = Instance.new("RemoteEvent", remotes); buyEvent.Name = "KaufTeil"
local installEvent = Instance.new("RemoteEvent", remotes); installEvent.Name = "TeilEinbauen"
local invUpdated = Instance.new("RemoteEvent", remotes); invUpdated.Name = "InventarAktualisiert"
local getInvFn = Instance.new("RemoteFunction", remotes); getInvFn.Name = "HoleInventar"
local getPartsFn = Instance.new("RemoteFunction", remotes); getPartsFn.Name = "HoleTeileliste"
local mofaSpawnFn = Instance.new("RemoteFunction", remotes); mofaSpawnFn.Name = "MofaSpawnen"
local wheelieEvent = Instance.new("RemoteEvent", remotes); wheelieEvent.Name = "Wheelie"
local waehleSpawn = Instance.new("RemoteEvent", remotes); waehleSpawn.Name = "WaehleSpawn"
local oeffneShop = Instance.new("RemoteEvent", remotes); oeffneShop.Name = "OeffneShop"
local ServerStorage = game:GetService("ServerStorage")

---------------------------------------------------------------- Spawnpunkte: Spieler waehlt beim Beitritt
local SPAWNS = {
	{ name = "Bahnhof Effretikon", pos = Vector3.new(0, 0, 20) },
	{ name = "Garage Bisikon (Werkstatt)", pos = Vector3.new(2800, 0, 5290) },
	{ name = "Mofakult-Fabrik", pos = Vector3.new(-1000, 0, 2000) },
}
local chosenSpawn = {} -- [UserId] = Index

local inventories = {} -- [UserId] = { [partId] = Anzahl }

---------------------------------------------------------------- Geld (leaderstats): Start CHF 250, verdient mit Liefer-Jobs
local START_GELD = 250

local function getGeld(player)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then
		ls = Instance.new("Folder")
		ls.Name = "leaderstats"
		local geld = Instance.new("IntValue")
		geld.Name = "Geld"
		geld.Value = START_GELD
		geld.Parent = ls
		ls.Parent = player
	end
	return ls:FindFirstChild("Geld")
end

local function getInv(player)
	local inv = inventories[player.UserId]
	if not inv then
		inv = {}
		inventories[player.UserId] = inv
	end
	return inv
end

getPartsFn.OnServerInvoke = function()
	return TuningData.PARTS
end

getInvFn.OnServerInvoke = function(player)
	return getInv(player)
end

buyEvent.OnServerEvent:Connect(function(player, category, partId)
	local part = TuningData.find(category, partId)
	if not part or part.stock then
		return -- unbekanntes Teil oder Serienteil (gehoert schon dazu, kein Kauf noetig)
	end
	local inv = getInv(player)
	local geld = getGeld(player)
	if not geld or geld.Value < part.price then
		invUpdated:FireClient(player, inv, ("Nicht genug Geld: CHF %d kostet das Teil."):format(part.price))
		return
	end
	geld.Value -= part.price
	inv[partId] = (inv[partId] or 0) + 1
	invUpdated:FireClient(player, inv, "Gekauft: " .. part.name)
end)

-- Sucht die naechste Mofa-Sitzbank (max. 20 Studs) ausgehend von der Spielfigur.
local function findNearbyMofa(player)
	local char = player.Character
	if not char or not char.PrimaryPart then
		return nil
	end
	local seat = char:FindFirstChildWhichIsA("Humanoid") and char.Humanoid.SeatPart
	if seat and seat.Parent and seat.Parent:GetAttribute("MofaTyp") then
		return seat.Parent
	end
	local best, bestDist
	for _, m in ipairs(workspace:GetDescendants()) do
		if m:IsA("Model") and m:GetAttribute("MofaTyp") then
			local part = m.PrimaryPart or m:FindFirstChild("Seat")
			if part then
				local d = (part.Position - char.PrimaryPart.Position).Magnitude
				if d < 22 and (not bestDist or d < bestDist) then
					best, bestDist = m, d
				end
			end
		end
	end
	return best
end

-- Veraendert ein paar sichtbare Teile am Mofa passend zur eingebauten Stufe.
local function updateVisual(mofa, category, index, count)
	local t = index / count -- 0 (Serie) .. 1 (beste Stufe)
	if category == "auspuff" then
		local p = mofa:FindFirstChild("AuspuffRohr")
		if p then
			p.Size = Vector3.new(0.7 + t * 0.7, 0.7 + t * 0.7, 2.6 + t * 1.6)
			p.Color = t > 0.6 and Color3.fromRGB(40, 40, 42) or Color3.fromRGB(190, 190, 195)
		end
	elseif category == "zylinder" then
		local p = mofa:FindFirstChild("ZylinderBlock")
		if p then
			p.Size = Vector3.new(1.3 + t * 0.9, 1.3 + t * 0.9, 1.6 + t * 0.6)
		end
	elseif category == "luftfilter" then
		local p = mofa:FindFirstChild("Filter")
		if p then
			p.Transparency = 0
			p.Size = Vector3.new(0.9 + t * 0.6, 0.9 + t * 0.6, 0.9 + t * 0.6)
			p.Color = t > 0.5 and Color3.fromRGB(210, 40, 40) or Color3.fromRGB(230, 230, 220)
		end
	elseif category == "vergaser" then
		local p = mofa:FindFirstChild("Vergaser")
		if p then
			p.Size = Vector3.new(0.5 + t * 0.3, 0.6, 0.9 + t * 0.3)
		end
	end
end

installEvent.OnServerEvent:Connect(function(player, category, partId)
	if not TuningData.PARTS[category] then
		return
	end
	local part = TuningData.find(category, partId)
	if not part then
		return
	end
	local mofa = findNearbyMofa(player)
	if not mofa then
		invUpdated:FireClient(player, getInv(player), "Kein Töffli in der Nähe.")
		return
	end
	if part.fits and not table.find(part.fits, mofa:GetAttribute("MofaTyp")) then
		invUpdated:FireClient(player, getInv(player), ("Das Teil passt nur auf %s."):format(table.concat(part.fits, "/")))
		return
	end
	if part.requires then
		local okReq = false
		for _, rid in ipairs(part.requires) do
			if mofa:GetAttribute("zylinder") == rid then
				okReq = true
				break
			end
		end
		if not okReq then
			invUpdated:FireClient(player, getInv(player), part.name .. " laeuft nur mit Big Deps 4 oder Simonini 100cc im Zylinder.")
			return
		end
	end
	local inv = getInv(player)
	if not part.stock then
		if (inv[partId] or 0) <= 0 then
			return -- Spieler besitzt das Teil nicht
		end
		inv[partId] -= 1
	end
	mofa:SetAttribute(category, partId)
	local list = TuningData.PARTS[category]
	local idx = 0
	for i, p in ipairs(list) do
		if p.id == partId then
			idx = i - 1
		end
	end
	updateVisual(mofa, category, idx, #list - 1)
	invUpdated:FireClient(player, inv, "Eingebaut: " .. part.name)
end)

---------------------------------------------------------------- Handy-Tool an jeden Spieler verteilen
local function giveHandy(player)
	if player.Backpack:FindFirstChild("Töffli-Handy") or (player.Character and player.Character:FindFirstChild("Töffli-Handy")) then
		return
	end
	local tool = Instance.new("Tool")
	tool.Name = "Töffli-Handy"
	tool.RequiresHandle = true
	tool.CanBeDropped = false
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.5, 1.6, 0.2)
	handle.Color = Color3.fromRGB(25, 25, 28)
	handle.Material = Enum.Material.SmoothPlastic
	handle.Parent = tool
	local screen = Instance.new("Part")
	screen.Name = "Bildschirm"
	screen.Size = Vector3.new(0.42, 1.3, 0.02)
	screen.Color = Color3.fromRGB(120, 180, 230)
	screen.Material = Enum.Material.Neon
	screen.CanCollide = false
	screen.Parent = tool
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = handle
	weld.Part1 = screen
	weld.Parent = screen
	screen.CFrame = handle.CFrame * CFrame.new(0, 0, 0.11)
	local script_ = script.Parent:WaitForChild("HandySkript"):Clone()
	script_.Disabled = false
	script_.Parent = tool
	tool.Parent = player.Backpack
end

Players.PlayerAdded:Connect(function(player)
	getGeld(player)
end)

---------------------------------------------------------------- Auszahlungen der Liefer-Jobs (aus dem Welt-Skript) und Töffli-Spawn
local jobGeld = ServerStorage:WaitForChild("JobGeld")
jobGeld.Event:Connect(function(player, amount)
	local geld = getGeld(player)
	if geld and typeof(amount) == "number" and amount > 0 then
		geld.Value += math.floor(amount)
	end
end)

-- GeldFrage: zieht Geld ab (Tanken, Töffli-Kauf) und meldet, ob es gereicht hat
local geldFrage = ServerStorage:WaitForChild("GeldFrage")
geldFrage.OnInvoke = function(player, amount)
	local geld = getGeld(player)
	if geld and typeof(amount) == "number" and amount >= 0 and geld.Value >= math.floor(amount) then
		geld.Value -= math.floor(amount)
		return true
	end
	return false
end

mofaSpawnFn.OnServerInvoke = function(player, typ)
	local spawner = ServerStorage:FindFirstChild("MofaSpawner")
	if not spawner then
		return "Toeffli-System laedt noch."
	end
	return spawner:Invoke(player, typ)
end

---------------------------------------------------------------- Wheelie mit Shift (Attribut liest das Welt-Skript)
wheelieEvent.OnServerEvent:Connect(function(player, active)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local seat = hum and hum.SeatPart
	local mofa = seat and seat.Parent
	if mofa and mofa:GetAttribute("MofaTyp") then
		mofa:SetAttribute("Wheelie", active == true)
	end
end)

---------------------------------------------------------------- Spawnpunkt-Auswahl und Teleport bei Respawn
local function teleportToSpawn(player)
	local idx = chosenSpawn[player.UserId]
	if not idx then
		return
	end
	local spot = SPAWNS[idx]
	if not spot then
		return
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char }
	local origin = Vector3.new(spot.pos.X, 600, spot.pos.Z)
	local hit = workspace:Raycast(origin, Vector3.new(0, -1200, 0), params)
	local y = hit and hit.Position.Y + 4 or 5
	hrp.CFrame = CFrame.new(Vector3.new(spot.pos.X, y, spot.pos.Z))
end

waehleSpawn.OnServerEvent:Connect(function(player, idx)
	if typeof(idx) ~= "number" or not SPAWNS[idx] then
		return
	end
	chosenSpawn[player.UserId] = idx
	teleportToSpawn(player)
end)

local shopOeffnen = ServerStorage:WaitForChild("ShopOeffnen")
shopOeffnen.Event:Connect(function(player)
	oeffneShop:FireClient(player)
end)

local function giveSpawnAuswahl(player)
	local pg = player:FindFirstChild("PlayerGui")
	if pg and not pg:FindFirstChild("SpawnAuswahl") then
		local src = script.Parent:FindFirstChild("SpawnAuswahl")
		if src then
			local clone = src:Clone()
			clone.Disabled = false
			clone.Parent = pg
		end
	end
end

Players.PlayerAdded:Connect(function(player)
	getGeld(player)
	if player:FindFirstChild("Backpack") then
		giveHandy(player)
	end
	player.CharacterAdded:Connect(function()
		task.wait(0.3)
		giveHandy(player)
	end)
	player.CharacterAdded:Connect(function()
		task.wait(0.5)
		teleportToSpawn(player)
	end)
	giveSpawnAuswahl(player)
end)

for _, player in ipairs(Players:GetPlayers()) do
	if player.Character then
		giveHandy(player)
		teleportToSpawn(player)
	end
	player.CharacterAdded:Connect(function()
		task.wait(1)
		giveHandy(player)
	end)
	giveSpawnAuswahl(player)
end
